<nav-bar navbarData="{{navbarData}}"></nav-bar>
<view class="map-container">
  <tabs items="{{tabs}}" current="{{currentTabIndex}}" scrollMode="center" onChange="onTabChange" />
  <!-- 项目概览 -->
  <project-info-map projectInfo="{{projectInfo}}" a:if="{{currentTabIndex === 0}}"></project-info-map>
  <view a:if="{{currentTabIndex === 1}}">
    <!-- 项目进度 -->
    <project-progress></project-progress>
  </view>
  <view a:if="{{currentTabIndex === 2}}">
    <!-- 项目实景 -->
    <project-scenery></project-scenery>
  </view>
  <invest-control a:if="{{ currentTabIndex=== 3 }}"></invest-control>
  <project-bidding-progress a:if="{{ currentTabIndex=== 4 }}" projectId="{{projectInfo.id}}"></project-bidding-progress>
</view>