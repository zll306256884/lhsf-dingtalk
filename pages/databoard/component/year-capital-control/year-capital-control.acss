.container .top-money{
  margin: 24rpx 24rpx 48rpx 24rpx;
}
.top-money{
  height: 520rpx;
  position: relative;
}
.image{
  width: 100%;
  height: 100%;
}
.content-money{
  padding: 40rpx;
  position: absolute;
  top: 0;
  left: 0;
}
.container {
  margin-bottom: 30px;
}
.money-title{
  color: #FFFFFF;
  font-size: 24rpx;  
}
.budget-money{
  font-family: DIN Alternate, DIN Alternate;
color: #FFFFFF;
font-weight: bold;
font-size: 56rpx;
margin-bottom: 50rpx;
}
.bo-money{
  display:flex;
  justify-content: space-between;
  flex-wrap: wrap;
  align-items: center;
  width: 622rpx;
height: 294rpx;
border-radius: 42rpx 42rpx 42rpx 42rpx;
opacity: 1;
}
.pay{
 width:240rpx; 
}
.sun-text{
  margin-bottom: 8rpx;
  color: #FFFFFF;
  font-size: 24rpx;
}
.sum{
color: #FFFFFF;
font-family: DIN Alternate, DIN Alternate;
font-weight: bold;
font-size: 40rpx; 
text-overflow: ellipsis; /* 溢出显示省略号 */
overflow: hidden; /* 溢出隐藏 */
white-space: nowrap;
}
.bottom-content{
  padding: 28rpx;
 margin: 24rpx;
min-height: 762rpx;
background: #FFFFFF;
border-radius: 40rpx 40rpx 0rpx 0rpx;
opacity: 1;
}
.plan-money{
  display: flex;
}
.images{
  margin-right: 32rpx;
  width: 162rpx;
  height: 116rpx;
  border-radius: 12rpx 12rpx 12rpx 12rpx;
  background-repeat:no-repeat;
  opacity: 1;
  background: #eeeff0;
}
.images image{
  background-repeat:no-repeat;
  width: 100%;
  height: 100%;
  border-radius: 12rpx 12rpx 12rpx 12rpx;
}
.projectName{
  width: 374rpx;
  font-weight: 600;
  color: #1D1D1F;
  font-size: 32rpx;
}
.pay-text{
  margin-top:8rpx;
  font-size: 24rpx;
  width: 314rpx;
  color: #909399;
font-weight: 400;
}
.cont-tabs{
  padding: 0 6rpx;
  width: 210rpx;
  height: 72rpx;
  align-items: center;
  text-align: center;
  background: #F3F4F5;
  border-radius: 8rpx 8rpx 8rpx 8rpx;
  opacity: 1;
  display: flex;
}
.item-label{
  width: 105rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 4rpx 4rpx 4rpx 4rpx;
  opacity: 1;
}
