#projectScenery{
  /* width: 750rpx; */
  height: auto;
  background: #F5F5F5;
  padding: 20rpx 24rpx;
  padding-bottom: 106rpx;
}

#projectScenery .listArr{}

#projectScenery .listArr .part{
  margin-bottom: 32rpx;

}

#projectScenery .listArr .canvasNav{
  /* width: 702rpx; */
  height: 376rpx;
  /* background: white; */
  background: black;
  border-radius: 8rpx 8rpx 0rpx 0rpx;
  opacity: 1;
  overflow: hidden;
  /* margin-bottom: 20rpx; */
}

#projectScenery .listArr .canvasNav .imgShow{
  width: 100%;
  height: 100%;
}

#projectScenery .listArr .canvasNav .videoShow{
  width: 100%;
  height: 100%;
}

 

#projectScenery .listArr .bottomNav{
  /* width: 702rpx; */
  height: 96rpx;
  padding: 0 24rpx;
  border-radius: 0rpx 0rpx 8rpx 8rpx;
  opacity: 1;
  
  background-color: #fff;
}

#projectScenery .listArr .bottomNav .name{
  max-width: 100%;
  line-height: 96rpx;
  font-size: 32rpx;
  font-weight: 500;
  color: #1D1D1F;
}
#projectScenery .listArr .bottomNav .name .greenSpot{
  width: 12rpx;
  height: 12rpx;
  background: #00B42A;
  border-radius: 50%;
  opacity: 1;
  display: inline-block;
  line-height: 96rpx;
  margin-right: 10rpx;
}

#projectScenery .listArr .bottomNav .name .graySpot{
  width: 12rpx;
  height: 12rpx;
  background: #909399;
  border-radius: 50%;
  opacity: 1;
  display: inline-block;
  line-height: 96rpx;
  margin-right: 10rpx;
}

#projectScenery .listArr .time{
  font-size: 24rpx;
  color: #909399;
  background-color: #fff;
  padding: 0 24rpx 36rpx 24rpx;
  border-radius: 0rpx 0rpx 8rpx 8rpx;
}

/*  */
#projectScenery .mayflyBox {
  position: fixed;
  bottom: 100rpx;
  right: 30rpx;
}

#projectScenery .mayflyBox .mayfly{
  width: 172rpx;
  height: 156rpx;

}

/* 自定义弹窗 */
.body {
  background: #fff;
  padding: 30rpx;
  border-radius: 20rpx;
}
.body .body-row {
  display: flex;
  justify-content: flex-start;
  align-items: center;
  margin-bottom: 16rpx;
}
.body .body-row .body-label {
  white-space: nowrap;
  margin-right: 20rpx;
}