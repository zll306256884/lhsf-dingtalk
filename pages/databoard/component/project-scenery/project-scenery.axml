<view id="projectScenery" class="box-sizing-box">
  <view class="listArr">
    <!-- 监控的list -->
    <block a:if="{{fileData.length}}">
      <view class="part flex f-column" a:for="{{fileData}}">
        <block>
          <view class="canvasNav">
            <!-- <block a:if="{{item.fileType===1}}">
              <video class="videoShow" src="{{item.url}}"></video>
            </block> -->
            <block>
              <!-- aspectFit scaleToFill -->
              <image a:if="{{item.image}}" catchTap="_bindFileTap" data-obj="{{item}}" class="imgShow" mode="aspectFit" src="{{item.image}}" />
              <image a:else catchTap="_bindFileTap" data-obj="{{item}}" class="imgShow" mode="aspectFit" src="../../../../assets/images/progress/default.png" />
            </block>
          </view>
          <view class="bottomNav flex f-between">
            <view class="name single-line">{{item.name|| '-'}}</view>
            <view class="name online"  a:if="{{item.online}}">
              <view class="greenTypeBtn">在线</view>
            </view>
            <view class="name online"  a:if="{{!item.online}}">
              <view class="grayTypeBtn" style="display: inline-block;">离线</view>
            </view>
          </view>
          <view class="time" a:if="{{false}}">{{item.createTime|| '-'}}</view>
        </block>
      </view>
    </block>
    <!-- 现场实景的list -->
    <block a:if="{{fileData.length==0&&listData.length}}">
      <view class="part flex f-column" a:for="{{listData}}">
        <block>
          <view class="canvasNav">
            <block a:if="{{item.fileType===1}}">
              <video class="videoShow" src="{{item.url}}"></video>
            </block>
            <block a:else>
              <!-- aspectFit scaleToFill -->
              <image catchTap="_bindPreviewTap" data-previewindex="{{item.sn}}" data-index="{{index}}" data-url="{{item.url}}" 
                class="imgShow" mode="aspectFit" src="{{item.url}}" />
            </block>
          </view>
          <view class="bottomNav flex f-between">
            <view class="name single-line">{{item.progress|| '-'}}</view>
            <view class="online" a:if="{{false}}">在线</view>
          </view>
          <view class="time">{{item.createTime|| '-'}}</view>
        </block>
      </view>
    </block>
    <block a:if="{{listData.length===0&&fileData.length==0}}">
      <empty title="" message="" image="/assets/images/common/empty.png" />
    </block>
    
  </view>
  <!--  -->
  <view class="mayflyBox" catchTap="callIt" a:if="{{fileData.length||listData.length}}">
    <image class="mayfly" src="/assets/images/progress/callpic.png" />
  </view>
  <!--  -->
  
</view>