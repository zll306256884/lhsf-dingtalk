<!--<nav-bar navbarData="{{navbarData}}"></nav-bar> -->
<view class="container">
  <view class="containerinner">
    <!-- 头部 -->
    <view class="headerBox {{tabText !== '横道图' ? 'border-transparent' : ''}}">
      <view class="top flex f-between" a:if="{{tabText === '横道图'}}">
        <view class="flex f-start">
          <image class="titke-icon" src="../../../../assets/images/progress/titleleft.png" />
          <view class="title" catchTap="showIt">项目进度</view>
        </view>
        <view class="time" a:if="{{false}}">更新至2023-6-24 01:30:00</view>
      </view>
      <!-- new-里程碑 -->
      <view class="filterDemo {{className || ''}}" style="{{ style || ''}}">
        <view class="filterDemo-bar" a:if="{{tabText === '横道图'}}">
          <view a:for="{{ items }}" class="filterDemo-bar-item {{currentOpen=== index ? 'filterDemo-bar-item-active' : ''}}" 
            data-index="{{index}}" onTap="onTapItem">
            {{item.title}}
            <icon type="DownFill" a:if="{{index===0}}" className="filterDemo-bar-item-icon {{currentOpen=== index ? 'filterDemo-bar-item-icon-up' : ''}}" 
              size="x-small" /></view>
        </view>
        <view class="filterDemo-items" a:if="{{tabText === '横道图'}}">
          <view a:for="{{ items }}" class="filterDemo-items-content {{currentOpen=== index ? 'filterDemo-items-content-active' : ''}} {{contentClassName || ''}}" 
            style="{{contentStyle || ''}}">
            <selector options="{{item.options}}" onChange="handleChange" data-index="{{index}}" />
          </view>
        </view>
        <view class="tab-click">
          <ant-button
            type="primary"
            inline
            size="small"
            onTap="handleTabChange"
          >
            {{tabText}}
          </ant-button>
        </view>
      </view>
      <!--里程碑  -->
      <view class="lcb flex f-between box-sizing-box" a:if="{{false}}">
        <view class="flex f-start left" catchTap="milestoneNode">
          <image class="has" src="../../../../assets/images/progress/has.png" />
          <view class="name">里程碑节点</view>
        </view>
        <view class="flex f-start right">
          <view class='part flex f-start'>
            <view class="spotGreen"></view>
            已完成
          </view>
          <view class='part flex f-start'>
            <view class="spotOrange"></view>延期</view>
          <view class='part flex f-start'>
            <view class="spotBlue"></view>进行中</view>
        </view>
      </view>
      <!--  -->
    </view>
    <!-- 列表 -->
    <view class="listBox" a:if="{{tabText === '横道图'}}">
      <progress-item listData={{listData}} projectId={{projectId}} formPage='databoard' ref='progressItemRef'></progress-item>
    </view>
    <web-view a:else id="web-view-1" src="{{webViewUrl}}" onMessage="onMessage"></web-view>
  </view>
</view>