.status-item .status-count {
  font-weight: 600;
}
.card-list {
  width: 100%;
  position: absolute;
  bottom: 0;
}
.card-list .card-item {
  position: relative;
  width: 640rpx;
  height: 258rpx;
  box-sizing: border-box;
  margin: 0 auto;
  padding: 24rpx;
  background: #ffffff;
  box-shadow: 20rpx 32rpx 60rpx -24rpx rgba(0, 0, 0, 0.15);
  border-radius: 24rpx;
  opacity: 1;
}

.item-img {
  width: 280rpx;
  height: 210rpx;
  margin-right: 24rpx;
  background: #eeeff0;
}
.item-info {
  font-size: 24rpx;
  font-weight: 400;
  color: #606266;
  line-height: 48rpx;
}
.item-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #1d1d1f;
  line-height: 48rpx;
}
.item-status{
  height: 36rpx;
  border-radius: 8rpx;
  position: absolute;
  top:40rpx;
  left:8rpx;
  font-size: 20rpx;
  font-weight: 400;
  color: #FFFFFF;
  line-height: 36rpx;
  padding:0 12rpx
  }
.card-item .success {
  background: #26b76f;
}

.card-item .primary {
  background: #377dff;
}

.card-item .error {
  background: #f24c3d;
}

.card-item .warning {
  background: #f59e0f;
}

.card-item .info {
  background: #909399;
}

.card-item .orange {
  background: #ff7d00;
}
