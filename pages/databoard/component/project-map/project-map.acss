.status-item .status-count{
  font-weight: 600;
}
.card-list{
  width: 100%;
  position: absolute;
  bottom: 0;

}
.card-list .card-item{
  width: 640rpx;
  height: 258rpx;
  box-sizing: border-box;
  margin:0 auto;
  padding:24rpx;
  background: #FFFFFF;
  box-shadow: 20rpx 32rpx 60rpx -24rpx rgba(0,0,0,0.15);
  border-radius: 24rpx;
  opacity: 1;
}
.item-img{
  width: 100%;
  height: 100%;
  margin-right:24rpx
}
.item-info{
  font-size: 24rpx;
  font-weight: 400;
  color: #606266;
  line-height: 48rpx;
}
.item-title{
font-size: 32rpx;
font-weight: 500;
color: #1D1D1F;
line-height: 48rpx;
}

