.amap-logo {
  display: none !important;
}
.amap-copyright {
  display: none !important;
}
.map-container{
  position: relative;
}
.status-list{
  width: 100%;
  position: absolute;
  top:0;
  z-index:99

}
.status-list .ant-tabs-bar {
  background-color: transparent;

}
.status-list .ant-tabs-bar-capsule-title {
  margin-right: 24rpx;

}
.status-list .ant-tabs-bar-capsule-title {
  background-color: #fff;
}
