<view>
  <nav-bar navbarData="{{navbarData}}"></nav-bar>
  <nav-tab-bar tabList="{{tabList}}" onNavTabChange="onNavTabChange">
  </nav-tab-bar>
  <view class="navbox">
    <view a:if="{{ tabIndex==0 }}">
      待办审批1
