.message{
min-height: 110rpx;
background: #FFFFFF;
border-radius: 0rpx 0rpx 0rpx 0rpx;
opacity: 1;
padding: 32rpx;
margin: 20rpx 0;
}
.message-title{
font-size: 34rpx;
font-family: PingFang SC, PingFang SC;
font-weight: 500;
color: rgba(0,0,0,0.9);
margin-bottom: 10rpx;
}
.time{
font-size: 28rpx;
font-weight: 400;
color: rgba(0,0,0,0.5);
}
.bottom{
  background: #FFFFFF;
  padding: 32rpx 32rpx 20rpx 32rpx;
}
.message-content{
  min-width: 300rpx;
  border-bottom: solid 1rpx #EBEDF0;;
}
.title{
  font-size: 34rpx;
font-family: PingFang SC, PingFang SC;
font-weight: 500;
color: rgba(0,0,0,0.9);
margin-bottom: 20rpx;
}
.affiche-content{
  margin-top: 20rpx;
  font-size: 28rpx;
font-weight: 400;
color: rgba(0,0,0,0.5);
}
.accessory{
  font-size: 34rpx;
font-family: PingFang SC, PingFang SC;
font-weight: 500;
color: rgba(0,0,0,0.9);
padding: 30rpx 0;
}
.ant-empty-image-element {
  text-align: center;
  width: 67px!important;
  height: 100px!important;
}