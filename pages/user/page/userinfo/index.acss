.container {}

.container .title {
  width: 750rpx;
  height: 80rpx;
  border-radius: 0rpx 0rpx 0rpx 0rpx;
  opacity: 1;
  margin-top: 20rpx;
  padding: 32rpx 32rpx 32rpx 16rpx;
  font-size: 28rpx;
  color: #969799;
  line-height: 32rpx;
}


/* 列表 */
.list {
  margin-top: 20rpx;
  background-color: #FFFFFF;
}

.list .item {
  height: 100rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.list .item .left {
  /* margin-l: 24rpx; */
}

.list .item .left .icon-img {
  width: 52rpx;
  height: 52rpx;
  background: rgba(29, 206, 117, 0.2);
  border-radius: 10rpx 10rpx 10rpx 10rpx;
  opacity: 1;
  display: inline-block;
  /* margin-right: 24rpx; */
  margin: 24rpx 24rpx 24rpx 0;

}

.list .item .left .name {
  width: 578rpx;
  font-size: 32rpx;
  font-weight: 400;
  color: rgba(0, 0, 0, 0.9);
  line-height: 48rpx;
  height: 48rpx;
  border-bottom: 1rpx solid #F5F5F5;
  padding: 26rpx 0;
}

.list .item .icon-arrow {
  width: 32rpx;
  height: 32rpx;
  /* height: 100rpx; */
  padding: 34rpx 0;
}