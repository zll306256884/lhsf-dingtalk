.container {}

#baseinfo .title {
  width: 750rpx;
  /* height: 100rpx; */
  /* margin-top: 50rpx; */
  padding: 32rpx 32rpx 16rpx 20rpx;
  font-size: 28rpx;
  color: #969799;
  line-height: 32rpx;
}

#baseinfo .list{
  padding: 0 0 0 10rpx;
  background-color: #fff;
}

#baseinfo .margin-b20{
  margin-bottom: 20rpx;
}

.flex-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 0rpx 18rpx;
  padding: 24rpx 0rpx;
  border-top: 1px solid #E7EAF3;
}

.flex-row .label {
  line-height: 48rpx;
    font-size: 32rpx;
    font-weight: 400;
    color: rgb(82, 89, 102);
}

.flex-row .value {
  display: flex;
  justify-content: flex-start;
  align-items: center;
  line-height: 48rpx;
    font-size: 28rpx;
    color: rgb(82, 89, 102);
    text-align: right;
    white-space: normal;
    word-break: break-word;
}
.flex-row .blue-text {
  color: #1A6AFF;
}
