.container {
  width: 100%;
  height: 100%;
  background-color: #F5F5F5;
  position: relative;

}

.container .title {
  width: 100%;
  height: 100rpx;
  /* margin-top: 50rpx; */
  padding: 52rpx 32rpx 16rpx 32rpx;
  font-size: 28rpx;
  color: #969799;
  line-height: 32rpx;
}

.container .list {
  padding: 0 32rpx;
  background-color: #fff;
  margin-top: 20rpx;
}

.showTip{
  color:#1A6AFF;
  font-size:24rpx;
  padding-left:32rpx;
}


.judge {
  /* margin-top: 64rpx; */
  width: 100%;
  height: 88rpx;
  background: #FFFFFF;
  border-radius: 0rpx 0rpx 0rpx 0rpx;
  opacity: 1;
  padding: 20rpx 32rpx 20rpx 50rpx;
  font-size: 28rpx;
}

.judge .right {
  color: #323233;
  line-height: 48rpx;
}

.judge .right .redstart {
  color: red;
}

.judge .left .input {
  width: 258rpx;
  font-size: 28rpx;
  height: 48rpx;
  line-height: 48rpx;
}

.judge .left .time {
  /* font-size: 28rpx; */
  width: 240rpx;
  height: 48rpx;
  /* background: #C8C9CC; */
  /* border-radius: 8rpx 8rpx 8rpx 8rpx;
  opacity: 1;
  line-height: 48rpx;
  color: #FFFFFF;
  text-align: center; */
}

/*  */
.bottomBtn {
  width: 750rpx;
  height: 112rpx;
  border-radius: 0rpx 0rpx 0rpx 0rpx;
  opacity: 1;
  padding: 16rpx;
  position: fixed;
  bottom: 100rpx;
  left: 0;
}

.bottomBtn .bottom {
  width: 365rpx;
  height: 96rpx;
  border-radius: 8rpx 8rpx 8rpx 8rpx;
  opacity: 1;
  font-size: 28rpx;
}

.btn1 {
  background-color: #FFFFFF;
  margin-right: 16rpx;
  color: #323233;
}