<view class="flex f-align-center field-input-layout {{borderTop ? 'border-top' : ''}} {{borderBottom ? 'border-bottom' : ''}}" 
  style="{{cssStyle}}">
  <view class="name {{mustFill ? 'star' : ''}} {{mustFillTransparent ? 'star-transparent' : ''}}" style="margin-left:-18rpx">
    {{name}}
  </view>
  <block a:if="{{disabled}}">
    <!-- three-line -->
    <view class="flex10 value active single-line" style="color: {{valueColor}}; text-align: {{valueLeft? 'left' : 'right'}};">
      {{value}}
    </view>
  </block>
  <block a:else>
    <input class="flex10 value" style="color: {{valueColor}}; text-align: {{valueLeft? 'left' : 'right'}}" name="{{inputName}}" 
      password="{{password}}" type="{{inputType}}" maxlength="{{maxlength}}" placeholder-class="placeholder-clas" placeholder="{{placeholder}}" 
      value="{{value}}" onInput="_bindInputChange" onBlur="_bindBlurChange" onConfirm='_bindBlurChange' />
  </block>
</view>