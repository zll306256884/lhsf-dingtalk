/* pages/common/component/error-view/error-view.wxss */
.empty-placeholder {
    display: block;
    text-align: center;
    z-index: 99;
}

.empty-placeholder .empty-img {
    width: 120rpx;
    height: 120rpx;
    display: block;
    margin: 0 auto;
}

.empty-placeholder .empty-msg {
    display: block;
    text-align: center;
    margin-top: 20rpx;
    font-size: 26rpx;
    color: #999999;
}

.empty-placeholder .btn {
    width: 360rpx;
    height: 80rpx;
    line-height: 80rpx;
    margin: 60rpx auto 0;
    border-radius: 10rpx;
    background-color: #377DFF;
    font-size: 28rpx;
    color: white;
    text-align: center;
}

/* load more */
.load-more-wrap {
    width: 100%;
    display: flex;
    padding: 15rpx 0;
    -webkit-box-orient: horizontal;
    -webkit-box-direction: normal;
    -webkit-flex-direction: row;
    -ms-flex-direction: row;
    flex-direction: row;
    -webkit-box-align: center;
    -webkit-align-items: center;
    -ms-flex-align: center;
    align-items: center;
    -webkit-box-pack: center;
    -webkit-justify-content: center;
    -ms-flex-pack: center;
    justify-content: center;
}

.load-more-wrap .icon {
    width: 32rpx;
    height: 32rpx;
}

.load-more-wrap .content {
    font-size: 26rpx;
    color: #999;
    margin-left: 10rpx;
    position: relative;
}