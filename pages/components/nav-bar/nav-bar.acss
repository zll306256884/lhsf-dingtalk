/* common/components/nav-bar.wxss */
.nav-wrap {
    position: fixed;
    left: 0px;
    top: 0px;
    right: 0px;
    z-index: 99999;
}

.nav-wrap .nav-title {
    max-width: 200px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: #222222;
    font-size: 18px;
    font-weight: bold;
    position: absolute;
    left: 36px;
    right: 36px;
    bottom: 0px;
}

.nav-wrap .nav-title.active {
    left: 20px;
    right: 20px;
}

.nav-wrap .nav-title.center {
    text-align: center;
}

.nav-wrap .nav-back {
    padding: 0 15px;
    position: absolute;
    left: 0px;
    bottom: 0px;
}
.nav-wrap .nav-back-home {
  padding: 0 15px;
  position: absolute;
  right: 90px;
  bottom: 0px;
}

.nav-back .icon-back {
    display: block;
    width: 8px;
    height: 15px;
}