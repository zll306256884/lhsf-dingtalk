.dialog-mask {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 9999;
    background: rgba(0, 0, 0, 0.6);
}

.dialog-wrap {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 580rpx;
    background-color: #fff;
    z-index: 10000;
}

.dialog-wrap .picker-view-header {
    padding: 0 30rpx;
    height: 100rpx;
    font-size: 28rpx;
    line-height: 100rpx;
    color: #999;
    font-weight: bold;
    border-bottom: 1px solid #f6f6f6;
}

.dialog-wrap .picker-view-header .sure {
    color: #377DFF;
}

.dialog-wrap .picker-view-header .dialog-picker-title {
    font-size: 32rpx;
    color: #666666;
    text-align: center;
    margin: 0 20rpx;
}

.dialog-wrap .picker-view {
    background-color: white;
}

.dialog-wrap .picker-view .item {
    font-size: 28rpx;
}