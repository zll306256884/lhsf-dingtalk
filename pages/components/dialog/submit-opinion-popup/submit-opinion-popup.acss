.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 9999;
}

.modal-content {
  width: 100%;
  padding: 32rpx;
  background-color: white;
  border-radius: 20rpx 20rpx 0 0;
  z-index: 10000;
  position: fixed;
  bottom: 0rpx;
  /* top: 50%;
  left: 50%;
  -webkit-transform: translate(-50%, -50%);
  transform: translate(-50%, -50%); */
}

/* title */
.modal-content  .dialog-title {
  font-size: 36rpx;
  color: #343C4A;
  font-weight: bold;
  text-align: center;
}

.modal-content .dialog-name {
  margin-top: 52rpx;
  font-size: 28rpx;
  color: #323233;
}

/*  content */
.modal-content .reason {
  margin: 30rpx 0 0;
  padding: 0rpx;
  height: 120rpx;
  font-size: 28rpx;
  color: #525966;
  border-radius: 10rpx;
  border: 1px solid #E7EAF3;
  border-top: 0;
  border-left: 0;
  border-right: 0;
}
.file{
  margin-top: 30rpx;
  border-bottom:1rpx solid #EBEDF0;
  padding-bottom: 20rpx;
}

/* btn */
.modal-content .btn-wrap {
  margin: 50rpx 0 0;
}

.modal-content .btn-wrap .btn {
  width: 216rpx;
  height: 80rpx;
  margin-left: 20rpx;
  line-height: 80rpx;
  border-radius: 10rpx;
  color: #323233;
  font-size: 28rpx;
  border: 2rpx solid #EBEDF0;
}

.modal-content .btn-wrap .btn.active {
  margin-left: 30rpx;
  border: none;
  background-color: #1A6AFF;
  color: white;
}

.approve-btn{
  border-top: 1px solid #EBEDF0;
  padding: 16rpx;
  background: #fff;
}
.approve-btn .btn{
  width: 227rpx;
  height: 80rpx;
  background: #FFFFFF;
  border-radius: 8rpx 8rpx 8rpx 8rpx;
  opacity: 1;
  border: 2rpx solid #EBEDF0;
  font-size: 28rpx;
  font-weight: 400;
  color: #323233;
  line-height: 80rpx;
}
.approve-btn .active{
  width: 227rpx;
  height: 80rpx;
  background: #1A6AFF;
  border-radius: 8rpx 8rpx 8rpx 8rpx;
  opacity: 1;
  font-size: 28rpx;
  font-weight: 400;
  color: #FFFFFF;
  line-height: 80rpx;
}
.approve-btn .big-btn {
  width: 100% !important;
}

.container .containerinner .textarea {
  z-index: 0;
}

/* 更多按钮区域 */
.btn-dialog {
  position: fixed;
  left: 0;
  bottom: 120rpx;
  width: 100%;
  height: auto;
  background: #fff;
  border-radius: 20rpx;
  border: 1rpx solid #ccc;
  padding: 20rpx;
  box-sizing: border-box;
}

.btn-dialog .btn{
  width: 100%;
  height: 80rpx;
  background: #FFFFFF;
  border-radius: 8rpx 8rpx 8rpx 8rpx;
  opacity: 1;
  border: 2rpx solid #EBEDF0;
  font-size: 28rpx;
  font-weight: 400;
  color: #323233;
  line-height: 80rpx;
  margin-bottom: 10rpx;
}
.btn-dialog .active{
  width: 100%;
  height: 80rpx;
  background: #1A6AFF;
  border-radius: 8rpx 8rpx 8rpx 8rpx;
  opacity: 1;
  font-size: 28rpx;
  font-weight: 400;
  color: #FFFFFF;
  line-height: 80rpx;
}

.file-title {
  font-size: 32rpx;
  font-weight: 400;
  color: rgb(82, 89, 102); 
  margin: 20rpx 0 8rpx;
}