<block>
  <view class="forward-btn">
    <button a:if="{{transmit === '0' && recipient}}" class="btn big-btn" catchTap="handleTransmit">转发</button>
    <button a:if="{{transmit === '0' && !recipient}}" class="btn big-btn" catchTap="handleTransmit">附言</button>
  </view>
</block>

<view a:if="{{showTransmit}}" class="modal-mask" catchTouchMove="_bindTouchMove"></view>
<view a:if="{{showTransmit}}" class="box-sizing-box modal-content" catchTouchMove="_bindTouchMove">
  <view class="dialog-title">{{isTransmit ? '流程转发' : '附言'}}</view>
  <form onSubmit="handleTransmitConfirm">
    <view a:if="{{recipient}}" catchTap="chooseManager">
      <layout-field-input borderBottom name="接收人" mustFill disabled="true" value="{{chooseUser}}" placeholder="请选择"></layout-field-input>
    </view>
    <view style="margin: 0 30rpx;">
      <view class="file-title">附言</view>
      <textarea class="reason" name="remark" maxlength="300" placeholder="请输入" placeholder-class="placeholder-class"></textarea>
      <block a:if="{{!recipient}}">
        <view class="file-title">附件</view>
        <layout-upload-img cssStyle="margin: 0rpx 0 0;padding: 10rpx 30rpx 30rpx;" ref="onSaveUploadFileRef" onlyUploadImage="{{true}}"></layout-upload-img>
      </block>
    </view>
    <!-- btn -->
    <view class="flex f-center btn-wrap">
      <button class="btn" catchTap="handleCancel">取消</button>
      <button class="btn active" disabled="{{isTransmitLoading}}" loading="{{isTransmitLoading}}" form-type="submit">确定</button>
    </view>
  </form>
  <!-- <view catchTap="chooseManager">
    <form-input label="接收人" name="people" placeholder="请选择" required disabled ref="handleRef"><icon slot="suffix" type="RightOutline" /></form-input>
  </view>
  <form-textarea label="附言" name="remark" placeholder="请输入" maxLength="{{300}}" position="vertical" allowClear autoHeight 
    ref="handleRef"></form-textarea>
  <view class="file-title">附件</view>
  <layout-upload-img cssStyle="margin: 0rpx 0 0;padding: 10rpx 30rpx 30rpx;" ref="onSaveUploadFileRef"></layout-upload-img>
  <view class="flex f-center btn-wrap">
    <button class="btn" catchTap="handleCancel">取消</button>
    <button class="btn active" disabled="{{isTransmitLoading}}" loading="{{isTransmitLoading}}" catchTap="handleTransmitConfirm">确定</button>
  </view> -->
</view>

<dialog-screen-company-staff ref="onSaveDialogScreenDepartmentManagerRef" multiChoose onScreenCallBack="bindScreenDepartmentManagerCallBack"></dialog-screen-company-staff>