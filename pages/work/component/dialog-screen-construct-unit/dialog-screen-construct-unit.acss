.modal-mask {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 9999;
}

.modal-content-content {
    width: 100%;
    padding: 0;
    background-color: white;
    z-index: 10000;
    position: fixed;
    left: 0;
    right: 0;
    border-radius: 24rpx 24rpx 0rpx 0rpx;
}
.modal-content-content .content-content{
  padding: 24rpx 32rpx;
}
.modal-content-content .content-content .dialog-name {
  /* padding: 30rpx 40rpx; */
  font-size: 32rpx;
  /* font-family: PingFang SC-Regular, PingFang SC; */
  font-weight: 400;
  color: rgba(0,0,0,0.9);
  line-height: 40rpx;
  padding: 0;
}
.modal-content-content .content-content .dialog-code{
  font-size: 24rpx;
  /* font-family: PingFang SC-Regular, PingFang SC; */
  font-weight: 400;
  color: rgba(0,0,0,0.4);
  line-height: 28rpx;
  margin-top: 16rpx;
}

.modal-content-content .content-content .dialog-name.active {
    color: #377DFF;
}
.modal-content-content .content-content .dialog-code.active {
  color: #377DFF;
}
.picker-view-header {
  padding: 0 30rpx;
  height: 100rpx;
  font-size: 28rpx;
  line-height: 100rpx;
  color: #999;
  font-weight: bold;
  border-bottom: 1px solid #f6f6f6;
}

.picker-view-header .sure {
  color: #377DFF;
}

.picker-view-header .dialog-picker-title {
  font-size: 32rpx;
  color: #323233;
  text-align: center;
  margin: 0 20rpx;
}
.search-wrap-wrap{
  margin:20rpx 24rpx;
  padding: 0 24rpx;
  height: 68rpx;
  background: #F7F8FA;
  border-radius: 34rpx 34rpx 34rpx 34rpx;
  opacity: 1;
}
.search-wrap-wrap .icon-search{
  width: 32rpx;
  height: 32rpx;
}
.search-wrap-wrap .search-input{
  background: #F7F8FA;
  font-size: 28rpx;
  font-family: PingFang SC-Regular, PingFang SC;
  font-weight: 400;
  color: #000;
  line-height: 68rpx;
  width: 85%;
}