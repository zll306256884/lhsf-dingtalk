<import-sjs from="../../../../utils/utils.sjs" name="utils" />
<nav-bar navbarData="{{navbarData}}"></nav-bar>
<tabs items="{{items}}" current="{{current}}" onChange="onNavTabChange" />

<view a:if="{{ current===0 }}" style="margin-bottom:150rpx;">
  <view class="top-card flex f-between f-align-center">
    <view class="top-card-left">
      <view class="name">由{{detailInfo.createName}}创建</view>
      <view class="time">{{detailInfo.createTime}}</view>
    </view>
    <view class="top-card-status {{detailInfo.approvalStatus === 3?'red-bg': detailInfo.approvalStatus=== 4?'green-bg':''}} ">
      {{['','未提交','审批中','已驳回','已办结','草稿'][detailInfo.approvalStatus]}}
    </view>
  </view>

  <list>
    
    <list-item extraBrief="{{detailInfo.title}}">标题</list-item>
    <list-item extraBrief="{{detailInfo.projectName}}">项目名称</list-item>
    <list-item extraBrief="{{detailInfo.projectLeader}}">项目负责人</list-item>
    <list-item extraBrief="{{detailInfo.affiliateUnit}}">项目所属单位</list-item>

    <list-item extraBrief="{{detailInfo.tenderingAgencyName}}">招标代理单位</list-item>
    <list-item extraBrief="{{detailInfo.biddingType_dictText}}">招标方式</list-item>

    <list-item extraBrief="{{detailInfo.tenderName}}">招标名称</list-item>
    <list-item extraBrief="{{detailInfo.projectLeader}}">项目负责人</list-item>
    <list-item extraBrief="{{detailInfo.biddingPerson}}">招标人</list-item>
    
    <list-item extraBrief="{{detailInfo.projectType_dictText}}">项目类别</list-item>
    <list-item extraBrief="{{detailInfo.tenderAmount}}">招标标的额（万元）</list-item>
    <list-item extraBrief="{{detailInfo.decisionBasis_dictText}}">决策依据</list-item>
    <list-item extraBrief="{{detailInfo.countersignLeader_dictText}}">会签领导</list-item>
    
    <list-item extraBrief="{{utils.parseTime(detailInfo.applicationTime,'{y}-{m}-{d}')}}">申请日期</list-item>

    <list-item>
      招标内容
      <view style="margin-top:10rpx;color: #969799;">{{detailInfo.biddingContent}}</view>
      <!-- <textarea style="margin-top:10rpx;" value="{{detailInfo.biddingContent}}" autoHeight disabled /> -->
    </list-item>
  </list>
  <view class="file-list">
    <view class="title">招标文件会签附件</view>
    <view class="flex f-between list-item" a:for="{{ detailInfo.tenderDocumentList }}" a:key="index">
      <view class="flex f-start" style="align-items:center">
        <image a:if="{{ item.url.indexOf('.pdf') !== -1 }}" mode="scaleToFill" src="/assets/images/file/icon_file_pdf.png" style="width: 72rpx; height: 72rpx;margin-right:18rpx;" />
        <image a:if="{{ item.url.indexOf('.ppt') !== -1 }}" mode="scaleToFill" src="/assets/images/file/icon_file_ppt.png" style="width: 72rpx; height: 72rpx;margin-right:18rpx;" />
        <image a:if="{{ item.url.indexOf('.png') !== -1 || item.url.indexOf('.jpg') !== -1 || item.url.indexOf('.jpeg') !== -1}}" mode="scaleToFill" src="/assets/images/file/icon_file_image.png" style="width: 72rpx; height: 72rpx;margin-right:18rpx;" />
        <image a:if="{{ item.url.indexOf('doc') !== -1 || item.url.indexOf('docx') !== -1}}" mode="scaleToFill" src="/assets/images/file/icon_file_word.png" style="width: 72rpx; height: 72rpx;margin-right:18rpx;" />
        <view>
          <view class="name">{{item.fileName}}</view>
          <!-- <view class="size">{{item.size || '-'}}</view> -->
        </view>
      </view>
      <image class="down-icon" data-url="{{item.url}}" mode="scaleToFill" src="/assets/images/common/download.png" catchTap="downloadFile"/>
    </view>
  </view>

  <view class="file-list">
    <view class="title">委托依据</view>
    <block a:if="{{ otherDocumentList }}">
      <view class="flex f-between list-item" a:for="{{ detailInfo.otherDocumentList }}" a:key="index">
        <view class="flex f-start" style="align-items:center">
          <image a:if="{{ item.url.indexOf('.pdf') !== -1 }}" mode="scaleToFill" src="/assets/images/file/icon_file_pdf.png" style="width: 72rpx; height: 72rpx;margin-right:18rpx;" />
          <image a:if="{{ item.url.indexOf('.ppt') !== -1 }}" mode="scaleToFill" src="/assets/images/file/icon_file_ppt.png" style="width: 72rpx; height: 72rpx;margin-right:18rpx;" />
          <image a:if="{{ item.url.indexOf('.png') !== -1  || item.url.indexOf('.jpg') !== -1 || item.url.indexOf('.jpeg') !== -1}}" mode="scaleToFill" src="/assets/images/file/icon_file_image.png" style="width: 72rpx; height: 72rpx;margin-right:18rpx;" />
          <image a:if="{{ item.url.indexOf('doc') !== -1 || item.url.indexOf('docx') !== -1}}" mode="scaleToFill" src="/assets/images/file/icon_file_word.png" style="width: 72rpx; height: 72rpx;margin-right:18rpx;" />
          <view>
            <view class="name">{{item.fileName}}</view>
            <!-- <view class="size">{{item.size || '-'}}</view> -->
          </view>
        </view>
        <image class="down-icon" data-url="{{item.url}}" mode="scaleToFill" src="/assets/images/common/download.png" catchTap="downloadFile"/>
      </view>
    </block>
    <view a:else class="flex f-center">
      <image mode="scaleToFill" src="/assets/images/common/empty.png" style="width:134rpx;height:200rpx;" />
    </view>
  </view>

  <list-item>
    备注内容
    <view style="margin-top:10rpx;color: #969799;">{{detailInfo.remark}}</view>
  </list-item>

  <view a:if="{{ requestType === '0' }}" class="bottom-content flex f-between">
    <button class="bottom-button" size="default" type="primary" catchTap="deletThis">删除</button>
    <button class="bottom-button active" size="default" type="primary" catchTap="editThis" style="background: #1A6AFF;color:#fff">编辑</button>
  </view>

  <view a:if="{{ requestType === '1' }}" class="bottom-content flex f-between">
    <button class="bottom-button active" size="default" type="primary" style="width:714rpx" catchTap="withdrawApplication">撤回申请</button>
  </view>

  <view a:if="{{ requestType === '2' }}" class="bottom-content flex f-between">
    <!-- <button class="bottom-button active" size="default" type="primary" style="width:714rpx;background: #1A6AFF;color:#fff" catchTap="printThis">打印</button> -->
  </view>

  <!-- 有参数才显示 -->
  <view a:if="{{(examineId && approvalType === '1') || (examineId && detailInfo.approvalStatus === 2 && isCurrentAudit)}}" style="position:fixed;bottom:18rpx;width:100%">
    <submit-opinion-popup examineId="{{examineId}}" specialUserIds="{{detailInfo.countersignLeader}}" dingTalkFormList="{{dingTalkFormList}}" onApprovalOperate="bindApprovalOperateTap"></submit-opinion-popup>
  </view>
</view>
<block a:else>
  <approval-item projectId={{detailInfo.projectId}} keyId={{detailInfo.id}}></approval-item>
</block>
