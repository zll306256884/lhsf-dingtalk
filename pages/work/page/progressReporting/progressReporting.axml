<nav-bar navbarData="{{navbarData}}"></nav-bar>
<view class="container" id="progressReporting">
  <!-- 我是进度填报 -->
  <view catchTap="bindChooseProjectTap">
    <form-picker label="项目名称" arrow disabled options="{{projectListOptions}}" name="projectId" ref="handleRef" />
    <form-radio-group label="计划阶段" name="planType" required options="{{planStageOptions}}" ref="handleRef"/>
  </view>

  <!-- <layout-field-cell name="项目名称" mustFill placeholder="请选择" value="{{projectData.name}}" onArrowTap="bindChooseProjectTap">
  </layout-field-cell> -->
  
  <view class="flex f-between btn-wrap">
    <button class="btn" catchTap="bindCancelTap" style="margin-right:20rpx;">
      取消
    </button>
    <button class="btn active" form-type="submit" catchTap="bindSaveTap">填报</button>
  </view>
</view>

<!-- 项目名称选择 -->
<dialog-select-project ref="onSaveDialogScreenprojecteRef" fromProgress="true" onScreenCallBack="bindChooseProjectCallBack">
</dialog-select-project>