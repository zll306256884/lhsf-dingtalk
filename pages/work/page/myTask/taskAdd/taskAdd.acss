.ant-input-placeholder{
  color: #ccc;
}
 .ant-picker-value-text{
   color:#000
 }
.buttons {
  width: 100%;
  position: fixed;
  box-sizing: border-box;
  bottom:0;
  background: #ffffff;
  padding: 12px 12px 24px 12px;
}
.buttons .ant-button{
  width:48%;
  height: 80rpx;
}
.ant-button-default{
  box-shadow: none;
  color: #323233;
  border: 2rpx solid #EBEDF0!important
}
.ant-input-placeholder{
  text-align: right;
}
.ant-input-content{
  text-align: right
}


