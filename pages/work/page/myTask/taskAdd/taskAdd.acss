
.form-card{
  margin-top:16rpx;
  margin-bottom:86px;
}
.form-title{
/* width: 100%; */
height: 80rpx;
font-size: 28rpx;
font-weight: 400;
color: #969799;
line-height: 80rpx;
padding-left:32rpx;
background: #fff;
}
.ant-form-item-field{
  display: block;
}
