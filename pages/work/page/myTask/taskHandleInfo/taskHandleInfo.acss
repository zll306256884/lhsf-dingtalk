.buttons {
  width: 100%;
  position: absolute;
  box-sizing: border-box;
  bottom:0;
  padding: 12px 12px 48px 12px;
}
.buttons .ant-button{
  width:48%
}
.ant-button-default{
  box-shadow: none;
}
.form-title{
  width: 100%;
  height: 80rpx;
  font-size: 28rpx;
  font-weight: 400;
  color: #323233;
  line-height: 80rpx;
  padding-left:32rpx;
  
  }