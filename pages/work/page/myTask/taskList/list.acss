.card-tabs{
  width: 100%;
  background: #fff;
  padding:0 24rpx;
  position: fixed;
  box-sizing: border-box;
}
.ant-tabs-bar-scroll-view {
  justify-content: flex-start;
  height: 88rpx;
}
.ant-tabs-bar-item {
  margin-right: 40rpx;
  font-weight: 400;
  color: #606266;
  font-size: 28rpx;
}
.search-bar {
width: 100%;
height: 68rpx;
background: #F7F8FA;
border-radius: 34rpx;
opacity: 1;
margin:20rpx auto;
padding: 4px 8px;
box-sizing: border-box;
}
.ant-input-content{
background: #F7F8FA;
}
.search-bar-focus {
  border-color: #1677ff;
}
.card-list{
  margin-top:112px;
  height: 100%;
}
.list-item {
  padding: 24rpx 0;
  border-bottom: 2rpx solid #ebeef5;
}
.item-title {
  font-size: 34rpx;
  font-weight: 400;
  color: #1d1d1f;
  line-height: 40rpx;
  margin-bottom: 16rpx;
}
.item-status-error{
display: inline-block;
background: #FEECEC;
border-radius: 4rpx 4rpx 4rpx 4rpx;
opacity: 1;
font-size: 28rpx;
border: 2rpx solid #FDD9D9;
padding:8rpx 16rpx;
margin-right:16rpx;
color: #F53F3F;
}
.item-status-sucess{
display: inline-block;
border-radius: 4rpx 4rpx 4rpx 4rpx;
opacity: 1;
font-size: 28rpx;
border: 2rpx solid #CCF0D4;
padding:8rpx 16rpx;
margin-right:16rpx;
color: #00B42A ;
background: #E6F8EA;
}
.item-status-warning{
display: inline-block;
border-radius: 4rpx 4rpx 4rpx 4rpx;
opacity: 1;
font-size: 28rpx;
border: 2rpx solid #FFE5CC;
padding:8rpx 16rpx;
margin-right:16rpx;
color: #FF7D00;
background: #FFF2E6;
}

.item-time {
  display: block;
  font-size: 24rpx;
  font-weight: 400;
  color: rgba(0,0,0,0.4);
  line-height:40rpx;
  margin-top:8rpx
}
.item-name {
  display: block;
  font-size: 28rpx;
  font-weight: 400;
  color: rgba(0,0,0,0.5);
  line-height: 40rpx;
  }
  .buttons {
    width: 100%;
    position: fixed;
    box-sizing: border-box;
    bottom:0;
    background: #ffffff;
    padding: 12px 12px 48px 12px;
  }
  .ant-empty-image-element {
    width: 67px!important;
    height: 100px!important;
  }