.list-item {
  padding: 24rpx 0;
}
.item-title {
  font-size: 34rpx;
  font-weight: 400;
  color: #1d1d1f;
  line-height: 40rpx;
  margin-bottom: 16rpx;
}
.item-status{
display: inline-block;
background: #FEECEC;
border-radius: 4rpx 4rpx 4rpx 4rpx;
opacity: 1;
font-size: 28rpx;
border: 2rpx solid #FDD9D9;
padding:8rpx 16rpx;
margin-right:16rpx;
color: #F53F3F;
}
.item-status-sucess{
display: inline-block;
border-radius: 4rpx 4rpx 4rpx 4rpx;
opacity: 1;
font-size: 28rpx;
border: 2rpx solid #CCF0D4;
padding:8rpx 16rpx;
margin-right:16rpx;
color: #00B42A ;
background: #E6F8EA;
}
.item-status-warning{
display: inline-block;
border-radius: 4rpx 4rpx 4rpx 4rpx;
opacity: 1;
font-size: 28rpx;
border: 2rpx solid #FFE5CC;
padding:8rpx 16rpx;
margin-right:16rpx;
color: #FF7D00;
background: #FFF2E6;
}

.item-time {
  display: block;
  font-size: 24rpx;
  font-weight: 400;
  color: rgba(0,0,0,0.4);
  line-height:40rpx;
  margin-top:8rpx
}

.form-title{
  width: 100%;
  height: 80rpx;
  font-size: 28rpx;
  font-weight: 400;
  color: #969799;
  line-height: 80rpx;
  padding-left:32rpx;
  
  }
  .buttons {
    width: 100%;
    position: absolute;
    box-sizing: border-box;
    bottom:0;
    background: #ffffff;
    padding: 12px 12px 48px 12px;
  }
