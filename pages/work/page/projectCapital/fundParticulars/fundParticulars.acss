
.container{
margin-top: 20rpx;
}
.content{
  padding: 0rpx 32rpx;
  background: #FFFFFF;
  height: auto;
}
.content-text{
  display: flex;
  justify-content: space-between;
height: 88rpx;
line-height: 88rpx;
border-bottom: solid 1px #EBEDF0;
}
.content-text text:nth-child(1){
  font-size: 28rpx;
  font-weight: 400;
  color: #323233;
}
.content-text text:nth-child(2){
  font-size: 28rpx;
  font-weight: 400;
  color: #969799;
  width:450rpx;
  text-align: right;
  overflow: hidden; /* (文字长度超出限定宽度，则隐藏超出的内容） */
  white-space: nowrap; /* (（设置文字在一行显示，不能换行） */
  text-overflow: ellipsis; /* (（规定当文本溢出时，显示省略符号来代表被修剪的文本） */

}
.visualize{
  min-height: 150rpx;
border-bottom: solid 1px #EBEDF0;
}
.visualize view:nth-child(1){
  padding: 20rpx 0 15rpx 0;
}
.visualize view:nth-child(2){
  width: 686rpx;
  min-height: 80rpx;
  font-size: 28rpx;
  font-weight: 400;
  color: #969799;
  word-wrap: break-word;
}
.son{
font-size: 28rpx;
font-weight: 400;
color: #969799;
margin: 50rpx 0 16rpx 32rpx;
}
.for-content{
  margin-bottom: 20rpx;
}
