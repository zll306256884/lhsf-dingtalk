<nav-bar navbarData="{{navbarData}}"></nav-bar>
<view class="container">
  <view class="card">
    <tabs items="{{items}}"  defaultCurrent="{{0}}"  onChange="onQueryChange">
      <view
        class="content"
        slot-scope="item">
        {{item.value.content}}
      </view>
    </tabs>
  </view>
  <view a:if="{{isShow===0}}">
    <view class="content_text">
      <view class="proName">
        {{projectName?projectName:'-'}}
      </view>
      <view class="title">
        {{title?title:'-'}}
      </view>
      <view class="money">年度资金计划总额：
        {{yearAnnualFundPlanTotal?yearAnnualFundPlanTotal+'万元':'-'}}
      </view>
      <view class="money">年度累计计划支付金额：
        {{annualCumulativePlanPaymentAmount?annualCumulativePlanPaymentAmount+'万元':'-'}}
      </view>
    </view>

    <list>
      <list-item extraBrief="{{['','按项目','按合同'][planType]}}">计划填写方式：</list-item>
    </list>
    <view class="bottom-space" style="height:16rpx"></view>
    <block  a:if="{{ planType === 1 }}">
      <list>
        <list-item extraBrief="{{monthPlanTotal || '-'}}">月度资金计划总额(万元):</list-item>
      </list>
    </block>
    <block a:if="{{ planType === 2 }}">
      <view class="content-data" a:for="{{recordList}}" data-index={{index}} data-item="{{item}}" onTap="click">
        <view class="data-text">
          <list>
            <list-item arrow="right" >
              {{item.contractName?item.contractName:'-'}}
              <view class="plan-money"> 计划支付金额：{{item.plannedPaymentAmount}} </view>
            </list-item>
          </list>
        </view>
        <view class="bbbb"><divider /></view>
      </view>
    </block>
    
  </view>
  <view a:if="{{isShow}}">
    <view class="bottom-container">
      <text class="attachment">相关附件</text>
      <view>
        <layout-upload-img ref="onSaveUploadImgRef" disabled cssStyle="margin: 30rpx 15rpx 0;"></layout-upload-img>
      </view>
   </view>
  </view>
</view>