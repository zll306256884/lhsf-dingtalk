<nav-bar navbarData="{{navbarData}}"></nav-bar>

<view  class="container">
  <form onSubmit="bindFormSubmit">
    <view class="box-shadow">
      <form-input
          label="联系单名称"
          name="contactNoticeName"
          placeholder="请输入"
          maxlength="50"
          ref="handleRef"></form-input> 
          <form-input
           label="联系单编号"
           name="code"
           placeholder="请输入"
           ref="handleRef"></form-input> 
          <view a:if="{{disabled  ===false}}" catchTap="bindChooseProjectTap">
            <form-input
            label="项目名称"
            name="projectName"
            placeholder="请选择"
            disabled
            ref="handleRef"><icon slot="suffix" type="RightOutline" /></form-input>  
           </view>
           <view a:else>
            <form-input
            label="项目名称"
            name="projectName"
            placeholder="请选择"
            disabled
            ref="handleRef"><icon slot="suffix" type="RightOutline" /></form-input>  
           </view>  
           <form-input
           label="所属单位"
           name="affiliateUnit"
           placeholder="选择项目后自动带入"
           disabled
           ref="handleRef"></form-input>  
           <form-input
           label="项目累计变更(万元)"
           name="projectChangeAmount"
           placeholder="选择项目后自动带入"
           disabled
           ref="handleRef"></form-input>  
           <!-- <view>
            <form-input
              label="项目负责人"
              name="projectLeader"
              placeholder="选择"
              ref="handleRef">
              <icon slot="suffix" type="RightOutline" />
            </form-input> 

           </view> -->
           <form-picker
             label="项目负责人"
             arrow
             name="projectLeader"
             options="{{leaderList}}"
             ref="handleRef"
            ></form-picker>
           <view a:if="{{disabled  ===false}}" catchTap="bindChooseContractNameTap">
            <form-input
            label="合同名称"
            name="contractName"
            placeholder="请选择"
            disabled
            ref="handleRef"><icon slot="suffix" type="RightOutline" /></form-input>  
           </view>
           <view a:else>
            <form-input
            label="合同名称"
            name="contractName"
            placeholder="请选择"
            disabled
            ref="handleRef"><icon slot="suffix" type="RightOutline" /></form-input>  
           </view>
           <form-input
           label="合同金额(万元)"
           name="contractAmount"
           placeholder="选择合同后自动带入"
           disabled
           ref="handleRef"></form-input>  
           <form-input
           label="变更金额(万元)"
           name="changeAmount"
           placeholder="请输入"
           type="number"
           style="text-align:left"
           ref="handleRef" /> 
           <form-input
           label="合同累计变更(万元)"
           name="contractCumulativeChange"
           placeholder="选择合同后自动带入"
           disabled
           ref="handleRef"></form-input>
           <form-input
           label="合同变更率"
           name="contractChangeRate"
           placeholder="选择合同后自动带入"
           disabled
           ref="handleRef"></form-input>
           <view catchTap="bindChooseApplyDateTap">
            <form-input
            label="申请会签批准日期"
            name="countersignDate"
            placeholder="请选择"
            disabled
            ref="handleRef"><icon slot="suffix" type="RightOutline" /></form-input>
          </view>    
          <view catchTap="bindChooseChangeDateTap">
            <form-input
            label="变更内容完成时间"
            name="changeContentTime"
            placeholder="请选择"
            disabled
            ref="handleRef"><icon slot="suffix" type="RightOutline" /></form-input>
          </view>    
          <view catchTap="bindChooseBuildDateTap">
            <form-input
            label="施工单位上报日期"
            name="constructionUnitReportDate"
            placeholder="请选择"
            disabled
            ref="handleRef"><icon slot="suffix" type="RightOutline" /></form-input>
          </view> 
          <form-textarea
           label="联系单变更内容"
            position='vertical'
            name="contactChange"
            placeholder="请输入"
             maxLength="50"
             autoHeight
             ref="handleRef" /> 
             <form-textarea
             label="备注"
              position='vertical'
              name="remark"
              placeholder="请输入"
               maxLength="50"
               autoHeight
               ref="handleRef" />     
      <!-- <layout-field-input  name="联系单名称" maxlength="50" inputName="contactNoticeName" mustFill  value="{{contactNoticeName}}" placeholder="请输入"></layout-field-input>
      <layout-field-cell borderTop name="项目名称" mustFill placeholder="请选择" disabled="{{disabled}}" value="{{projectData.name}}" 
      onArrowTap="bindChooseProjectTap"></layout-field-cell>
      <layout-field-cell hidden={{false}} borderTop name="所属单位" mustFill placeholder="选择项目后自动带入"  value="{{affiliateUnit}}"></layout-field-cell>
      <layout-field-cell hidden={{false}} borderTop name="项目累计变更(万元)" mustFill placeholder="选择项目后自动带入"  value="{{projectChangeAmount}}"></layout-field-cell>
      <layout-field-cell hidden={{false}} borderTop name="项目负责人" mustFill placeholder="选择项目后自动带入"  value="{{projectLeader}}"></layout-field-cell>
      <layout-field-cell borderTop name="合同名称" disabled="{{disabled}}" mustFill placeholder="请选择"  value="{{contractData.contractName}}"  onArrowTap="bindChooseContractNameTap"></layout-field-cell>
      <layout-field-cell hidden={{false}} borderTop name="合同金额(万元)" mustFill placeholder="选择合同后自动带入"  value="{{contractAmount}}"></layout-field-cell>
      <layout-field-input borderTop name="变更金额(万元)"  inputType="number" inputName="changeAmount" mustFill disabled="{{isEdit}}" value="{{changeAmount}}" placeholder="请输入"></layout-field-input>
      <layout-field-cell hidden={{false}} borderTop name="合同累计变更(万元)" mustFill placeholder="选择合同后自动带入"  value="{{contractCumulativeChange}}"></layout-field-cell>
      <layout-field-cell hidden={{false}} borderTop name="合同变更率" mustFill placeholder="选择合同后自动带入"  value="{{contractChangeRate}}"></layout-field-cell>
      <layout-field-cell borderTop name="申请会签批准日期" mustFill placeholder="请选择" value="{{countersignDate}}" onArrowTap="bindChooseApplyDateTap"></layout-field-cell>
      <layout-field-cell borderTop name="变更内容完成时间" mustFillTransparent  placeholder="请选择" value="{{changeContentTime}}" onArrowTap="bindChooseChangeDateTap"></layout-field-cell>
      <layout-field-cell borderTop name="施工单位上报日期" mustFill placeholder="请选择" value="{{constructionUnitReportDate}}" onArrowTap="bindChooseBuildDateTap"></layout-field-cell>
      <layout-field-cell hidden={{false}} borderTop name="联系单变更内容" mustFill></layout-field-cell>
      <textarea class="desc" name="contactChange" maxlength="50" value="{{contactChange}}" placeholder="请输入内容" placeholder-class="placeholder-class"></textarea>
      <view style="height: 20rpx;"></view>
      <layout-field-cell hidden={{false}} mustFillTransparent borderTop name="备注" ></layout-field-cell>
      <textarea class="desc" name="remark" maxlength="300" value="{{remark}}" placeholder="请输入内容" placeholder-class="placeholder-class"></textarea>
      <view style="height: 20rpx;"></view> -->
    </view>
    <view class="box-shadow annex" style="padding-bottom: 30rpx;"><text class="annexTitle">*</text>
      <layout-field-cell cssStyle="margin-left:45rpx" hidden={{false}}   name="合同正式稿及相关附件"></layout-field-cell>
       <layout-upload-img ref="onSaveUploadImgRef" cssStyle="margin: 30rpx 30rpx 0;"></layout-upload-img>
    </view>
    <view class="box-shadow">
      <view catchTap="bindChooseExecuteLeaderTap">
      <form-input
      label="分管领导"
      name="subLeader_text"
      placeholder="请选择"
     disabled
      ref="handleRef"><icon slot="suffix" type="RightOutline" /></form-input>
    </view>
    </view>
    <view class="box-shadow annex" style="padding-bottom: 30rpx;"><text class="annexTitle">*</text>
      <layout-field-cell cssStyle="margin-left:45rpx" hidden={{false}}   name="变更小组会议纪要"></layout-field-cell>
       <layout-upload-img ref="onSaveUploadSummaryRef" type="1" cssStyle="margin: 30rpx 30rpx 0;"></layout-upload-img>
    </view>
    <view class="box-shadow annex" style="padding-bottom: 30rpx;"><text class="annexTitle">*</text>
      <layout-field-cell cssStyle="margin-left:45rpx" hidden={{false}}   name="变更内容"></layout-field-cell>
       <layout-upload-img ref="onSaveUploadAlterRef" type="2" cssStyle="margin: 30rpx 30rpx 0;"></layout-upload-img>
    </view>
    <view class="box-shadow bottom-shadow">
      <view catchTap="bindChooseExecuteUserTap" class="personlist">
        <!-- <form-input
        label="抄送人"
        name="person_text"
        placeholder="请选择"
        disabled
        ref="handleRef"><icon slot="suffix" type="RightOutline" /></form-input> -->
        <view class="personTitle">
          <text style="color:red">*</text>
          抄送人
        </view>
        <view class="personContent">
          <view>
            {{person_text===''?'请选择':person_text}}
          </view>
          <am-icon type="RightOutline" color="#1677ff" size="small" />
        </view>
      </view>
      <!-- <layout-field-cell mustFillTransparent  name="抄送人"  placeholder="请选择" value="{{person_text}}" onArrowTap="bindChooseExecuteUserTap"></layout-field-cell> -->
    </view>
    <view class="buttons flex f-between">
    <button class="btn" catchTap="bindCancelTap">取消</button>
    <button class="btn active" form-type="submit" onTap="submit">保存</button>
</view>
  </form>
</view>
<dialog-screen-leader ref="onSaveDialogScreenExecuteLeaderRef"  multiChoose onScreenCallBack="bindScreenExecuteLeaderCallBack"></dialog-screen-leader>
<dialog-screen-company-staff ref="onSaveDialogScreenExecuteUserRef"  multiChoose onScreenCallBack="bindScreenExecuteUserCallBack"></dialog-screen-company-staff>
<!-- <dialog-screen-suoshu-danwei ref="_onSaveDialogScreenShiGongUnitRef" positionBottom="{{true}}" onScreenCallBack="_bindScreenShiGongUnitCallBack"></dialog-screen-suoshu-danwei> -->
<dialog-screen-xiangmu-leixiang ref="onSaveDialogScreenprojectTypeRef" positionBottom="{{true}}"   onScreenCallBack="bindChooseProjectTypeCallBack"></dialog-screen-xiangmu-leixiang>
<dialog-select-project ref="onSaveDialogScreenprojecteRef"    onScreenCallBack="bindChooseProjectCallBack"></dialog-select-project>
<dialog-screen-hetong-mingcheng ref="onSaveDialogScreencontractRef" projectId="{{proId}}"  positionBottom="{{true}}"   onScreenCallBack="bindChooseContractCallBack"></dialog-screen-hetong-mingcheng>
<dialog-screen-fukuan-danwei ref="onSaveDialogScreenslowunitRef" projectId="{{projectId}}" positionBottom="{{true}}" onScreenCallBack="bindChooseSlowUnitCallBack"></dialog-screen-fukuan-danwei>
<dialog-screen-fukuan-danwei ref="onSaveDialogScreenproceedsunitRef" projectId="{{projectId}}" positionBottom="{{true}}" onScreenCallBack="bindChooseProceedsUnitCallBack"></dialog-screen-fukuan-danwei>
<dialog-picker-date ref="onSaveDialogScreenApplyDateRef" selectionMode="single" formatDate='YYYY-MM-DD'  onPickerCallBack="bindChooseApplyDateCallBack"></dialog-picker-date>
<dialog-picker-date ref="onSaveDialogScreenChangeDateRef" selectionMode="single" formatDate='YYYY-MM-DD'  onPickerCallBack="bindChooseChangeDateCallBack"></dialog-picker-date>
<dialog-picker-date ref="onSaveDialogScreenBuildDateRef" selectionMode="single" formatDate='YYYY-MM-DD'  onPickerCallBack="bindChooseBuildDateCallBack"></dialog-picker-date>