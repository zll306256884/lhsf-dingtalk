.container{
  position: relative;
}
.container .box-shadow {
  padding: 0 0;
  width: 100%;
}
.ant-input-placeholder{
  font-size: 30rpx;
}
.ant-form-item-label-horizontal{
  width: 150px;
}
.ant-input-content{
  text-align: right;
  font-size: 28rpx;
  color:#999
}
.ant-textarea-content{
  color:#999
}
.field-cell {
  margin: 0;
  padding: 30rpx 30rpx;
}
.ant-input-disabled{
  opacity: 1.4!important;
}
.box-shadow.field-cell {
  margin: 30rpx auto 0;
  padding: 30rpx 30rpx;
}

.field-cell .value,
.field-cell .input {
  font-size: 24rpx;
  text-align: right;
  color: #B8BFCC;
}

.field-cell .value.active,
.field-cell .placeholder-class.active {
  color: #525966;
}
.annex{
  position: relative;
}
.annexTitle{
  position: absolute;
  top: 31rpx;
left: 15rpx;
color:red;
font-size: 15px;
}
/* 任务描述 */
.box-shadow .desc {
  margin: 10rpx 30rpx 0;
  height: 100rpx;
  font-size: 28rpx;
  color: #525966;
}

/* btn */
.buttons{
  border-top: 1px solid #EBEDF0;
  padding: 16rpx 18rpx;
  margin-top: 16rpx;
  width: 718rpx;
  position: fixed;
  bottom: 0rpx;
  background: #fff;
  padding-bottom: 42rpx;
}
.bottom-shadow{
  margin-bottom: 150rpx!important;
}

.buttons .btn {
   width: 100%;
  height: 80rpx;
  background: #FFFFFF;
  border-radius: 8rpx 8rpx 8rpx 8rpx;
  opacity: 1;
  border: 2rpx solid #EBEDF0;
  font-size: 28rpx;
  font-family: PingFang SC-Regular, PingFang SC;
  font-weight: 400;
  color: #323233;
  line-height: 80rpx;
}

.btn.active {
  margin-left: 20rpx;
  color: #fff;
  background: #1A6AFF;
}

/* 任务描述 */
.box-shadow .desc {
  margin: 10rpx 30rpx 0;
  height: 100rpx;
  font-size: 28rpx;
  color: #525966;
}