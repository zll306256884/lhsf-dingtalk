<import-sjs from="../../../../utils/utils.sjs" name="utils" />
<nav-bar navbarData="{{navbarData}}"></nav-bar>
<tabs items="{{items}}" current="{{current}}" onChange="onNavTabChange" />

<view a:if="{{ current === 0 }}" style="margin-bottom:140rpx">
  <view class="top-card flex f-between f-align-center">
    <view class="top-card-left">
      <view class="name">由{{detailInfo.createBy_dictText}}创建</view>
      <view class="time">{{detailInfo.createTime}}</view>
    </view>
    <view class="top-card-status {{detailInfo.approvalStatus === 3?'red-bg': detailInfo.approvalStatus=== 4?'green-bg':''}} " >
      {{['','未提交','审批中','已驳回','已办结','草稿'][detailInfo.approvalStatus]}}
    </view>
  </view>

  <list>
    <list-item extraBrief="{{detailInfo.projectName}}">项目名称:</list-item>
    <list-item extraBrief="{{detailInfo.contractName}}">合同名称:</list-item>
    <list-item extraBrief="{{detailInfo.contractNumber || '-'}}">合同号:</list-item>
  </list>

  <view class="bottom-space" style="height:16rpx"></view>
  <list>
    <list-item extraBrief="{{detailInfo.projectAffiliation}}">项目所属单位:</list-item>
    <list-item extraBrief="{{detailInfo.projectLeader}}">项目负责人:</list-item>
    <list-item extraBrief="{{['否','是'][detailInfo.supplementAgreement]}}">是否补充协议:</list-item>
    <list-item a:if="{{ detailInfo.supplementAgreement=== 1 }}" extraBrief="{{detailInfo.masterContractName}}">主合同:</list-item>
    <list-item extraBrief="{{detailInfo.projectType_dictText || '-'}}">项目类型:</list-item>

    <list-item a:if="{{ detailInfo.contractType === 1 }}" extraBrief="{{['否','是'][detailInfo.contractNeedTender]}}">此合同是否需要招标</list-item>

    <list-item a:if="{{ detailInfo.contractType === 1 && detailInfo.contractNeedTender === 1 }}" extraBrief="{{detailInfo.tenderDocumentId === '1'?'格式招标文件':detailInfo.tenderName}}">选择招标文件</list-item>
    <list-item a:if="{{ detailInfo.contractType === 1 && detailInfo.contractNeedTender === 1 }}" extraBrief="{{detailInfo.biddingTypeName?detailInfo.biddingTypeName:detailInfo.biddingType_dictText?detailInfo.biddingType_dictText:'-'}}">招标方式</list-item>
    
    <list-item a:if="{{ detailInfo.contractType === 1 && detailInfo.contractNeedTender === 0}}" extraBrief="{{['','直接','其他'][detailInfo.modeContract]}}">发包方式</list-item>

    <list-item extraBrief="{{detailInfo.contractPeriodType === 1?((detailInfo.contractPeriod?detailInfo.contractPeriod:'/')+'天'):detailInfo.contractPeriodType === 2?((detailInfo.contractPeriodMonth?detailInfo.contractPeriodMonth:'/')+'月'):detailInfo.contractPeriodType === 3?('截止日期：'+(detailInfo.contractEndTime?detailInfo.contractEndTime:'/')): ''}}">合同工期</list-item>

    <list-item extraBrief="{{detailInfo.contractAmount?(detailInfo.contractAmount+(detailInfo.makeSure===0?'(待定)':'')):(0+(detailInfo.makeSure===0?'(待定)':''))}}">合同金额(万元)</list-item>

    <list-item a:if="{{ detailInfo.contractType === 2 }}" extraBrief="{{detailInfo.amountPaid || '-'}}">已支付金额(万元)</list-item>

  </list>
  <view class="bottom-space" style="height:16rpx"></view>
  <list>
    <list-item extraBrief="{{}}">
      <view>建设单位(甲方)</view>
      <!-- <ant-checkbox-group  slot="extra" options="{{ unitPartyModeOptions2 }}" value="{{ detailInfo.developmentOrganizationModeList }}" disabled /> -->
      <!-- <ant-selector slot="extra" style="width:100px"  value="{{ detailInfo.developmentOrganizationModeList }}" options="{{ unitPartyModeOptions2 }}" disabled multiple /> -->
    </list-item>
    <!-- <list-item extraBrief="{{detailInfo.developmentOrganizationName}}">政府单位名称：</list-item> -->
    <list-item a:if="{{ detailInfo.developmentOrganizationModeList?(detailInfo.developmentOrganizationModeList.includes('2')):false }}" extraBrief="{{detailInfo.developmentOrganizationListName}}">单位名称：</list-item>
    <list-item a:if="{{ detailInfo.developmentOrganizationModeList?(detailInfo.developmentOrganizationModeList.includes('3')):false }}" extraBrief="{{detailInfo.developmentOrganizationPerson}}">个人姓名</list-item>
    <list-item a:if="{{ detailInfo.developmentOrganizationModeList?(detailInfo.developmentOrganizationModeList.includes('3')):false }}" extraBrief="{{detailInfo.developmentOrganizationNumber}}">个人身份证号：</list-item>
  </list>

  <view class="bottom-space" style="height:16rpx"></view>
  <list>
    <list-item extraBrief="">乙方单位</list-item>
    <list-item a:if="{{ detailInfo.unitPartyMode === 2 }}" extraBrief="{{detailInfo.unitPartyName}}">单位名称：</list-item>
    <list-item a:if="{{ detailInfo.unitPartyMode === 2 }}" extraBrief="{{detailInfo.unitPartyType_dictText}}">单位类型：</list-item>
    <list-item a:if="{{ detailInfo.unitPartyMode === 3 }}" extraBrief="{{detailInfo.unitPartyPerson}}">姓名：</list-item>
    <list-item a:if="{{ detailInfo.unitPartyMode === 3 }}" extraBrief="{{detailInfo.unitPartyNumber}}">身份证号码：</list-item>
    <!-- <list-item extraBrief="{{detailInfo.projectName}}">第三方单位</list-item>
    <list-item extraBrief="{{detailInfo.contractName}}">第三方单位类型</list-item> -->
  </list>

  <list a:for="{{list}}" a:key="id">
    <view class="bottom-space" style="height:16rpx"></view>
    <list-item>
      <view class="flex f-between">
        <view> {{list[index].label1}} </view>
        <view class="ant-list-item-extra-brief"></view>
        <!-- <input style="width:80%" placeholder="请选择" value="{{list[index].thirdPartyName}}" data-index="{{index}}" onFocus="chooseThirdParty" /> -->
      </view>
    </list-item>
    <list-item a:if="{{ list[index].contractThirdMode === 2 }}">
      <view class="flex f-between">
        <view>单位名称：</view>
        <view class="ant-list-item-extra-brief">{{list[index].thirdPartyName}}</view>
        <!-- <input style="width:80%" placeholder="请选择" value="{{list[index].thirdPartyName}}" data-index="{{index}}" onFocus="chooseThirdParty" /> -->
      </view>
    </list-item>
    <list-item a:if="{{ list[index].contractThirdMode === 2 }}">
      <view class="flex f-between">
        <!-- <view>{{list[index].label2}}</view> -->
        <view>单位类型：</view>
        <view class="ant-list-item-extra-brief">{{list[index].thirdPartyType_dictText}}</view>
      </view>
      <!-- <picker slot="extra" options="{{unitTypeOption}}" value="{{list[index].thirdPartyType}}" data-index="{{index}}" onVisibleChange="chooseUnitType" onOk="chooseUnitTypeCallBack"></picker> -->
    </list-item>
    <list-item a:if="{{ list[index].contractThirdMode === 3 }}">
      <view class="flex f-between">
        <view>姓名：</view>
        <view class="ant-list-item-extra-brief">{{list[index].contractThirdPerson}}</view>
        <!-- <input style="width:80%" placeholder="请选择" value="{{list[index].thirdPartyName}}" data-index="{{index}}" onFocus="chooseThirdParty" /> -->
      </view>
    </list-item>
    <list-item a:if="{{ list[index].contractThirdMode === 3 }}">
      <view class="flex f-between">
        <view>身份证号码：</view>
        <view class="ant-list-item-extra-brief">{{list[index].contractThirdNumber}}</view>
        <!-- <input style="width:80%" placeholder="请选择" value="{{list[index].thirdPartyName}}" data-index="{{index}}" onFocus="chooseThirdParty" /> -->
      </view>
    </list-item>
    <!-- <list-item data-index="{{index}}" onTap="deleteThis" extraBrief="删除"></list-item> -->
  </list>

  <list>
    <view class="bottom-space" style="height:16rpx"></view>
    <list-item>
      合同内容：
      <view style="margin-top:10rpx;color: #323233;">{{detailInfo.contractContent || "-"}}</view>
    </list-item>
  </list>
  <view class="bottom-space" style="height:16rpx"></view>
  <list>
    <!-- <list-item extraBrief="{{detailInfo.paymentMethod_dictText}}">付款方式</list-item> -->
    <list-item>
      备注内容：
      <view style="margin-top:10rpx;color: #323233;">{{detailInfo.remark || "-"}}</view>
    </list-item>
  </list>
  <view class="bottom-space" style="height:16rpx"></view>
  <view class="file-list">
    <view class="title">合同正式稿及相关附件：</view>
    <layout-upload-img ref="onSaveUploadImgRef" disabled cssStyle="margin: 0rpx 0 0;"></layout-upload-img>
    <!-- <view class="flex f-between list-item" a:for="{{ detailInfo.fileList }}" a:key="index">
      <view class="flex f-start" style="align-items:center" catchTap="downloadFile" data-url="{{item.url}}">
        <image a:if="{{ item.url.indexOf('.pdf') !== -1 }}" mode="scaleToFill" src="/assets/images/file/icon_file_pdf.png" style="width: 72rpx; height: 72rpx;margin-right:18rpx;" />
        <image a:if="{{ item.url.indexOf('.ppt') !== -1 }}" mode="scaleToFill" src="/assets/images/file/icon_file_ppt.png" style="width: 72rpx; height: 72rpx;margin-right:18rpx;" />
        <image a:if="{{ item.url.indexOf('.png') !== -1 || item.url.indexOf('.jpg') !== -1 || item.url.indexOf('.jpeg') !== -1}}" mode="scaleToFill" src="/assets/images/file/icon_file_image.png" style="width: 72rpx; height: 72rpx;margin-right:18rpx;" />
        <image a:if="{{ item.url.indexOf('doc') !== -1 || item.url.indexOf('docx') !== -1}}" mode="scaleToFill" src="/assets/images/file/icon_file_word.png" style="width: 72rpx; height: 72rpx;margin-right:18rpx;" />
        <view>
          <view class="name">{{item.fileName}}</view>
        </view>
      </view>
      <image class="down-icon" mode="scaleToFill" src="/assets/images/common/download.png"  catchTap="downloadFile" data-url="{{item.url}}"/>
    </view> -->
  </view>
  <list>
    <!-- <list-item>
      合同正式稿及相关附件
      <layout-upload-img cssStyle="margin: 0rpx 0 0;padding: 10rpx 30rpx 30rpx;" disabled ref="onSaveUploadContractImgRef"></layout-upload-img>
    </list-item> -->

    <list-item a:if="{{ detailInfo.contractType === 1 }}" extraBrief="{{detailInfo.countersignLeader_dictText || '-'}}">选择会签分管领导：</list-item>
    <list-item extraBrief="{{utils.parseTime(detailInfo.applicationTime,'{y}-{m}-{d}')}}">申请日期：</list-item>
    <view class="bottom-space" style="height:16rpx"></view>
  </list>
  <!-- <view a:if="{{examineId && approvalType === '1'}}" class="bottom-space" style="height:150rpx"></view> -->
  <!-- 1:未提交 2:审批中 3:已驳回 4:已完结 5草稿 -->
  <view a:if="{{ requestType === '0' || (detailInfo.approvalStatus !== 2 && detailInfo.approvalStatus !== 4) }}" class="bottom-content flex f-between">
    <button class="bottom-button" size="default" type="primary" catchTap="deletThis">删除</button>
    <button class="bottom-button active" size="default" type="primary" catchTap="editThis" style="background: #1A6AFF;color:#fff">编辑</button>
  </view>

  <view a:if="{{ (requestType === '1' || detailInfo.approvalStatus === 2) && !examineId }}" class="bottom-content flex f-between">
    <button class="bottom-button active" size="default" type="primary" style="width:714rpx" catchTap="withdrawApplication">撤回申请</button>
  </view>

  <view a:if="{{ requestType === '2' }}" class="bottom-content flex f-between">
    <!-- <button class="bottom-button active" size="default" type="primary" style="width:714rpx;background: #1A6AFF;color:#fff" catchTap="printThis">打印</button> -->
  </view>

  <!-- 有参数才显示 -->
  <view a:if="{{(examineId && approvalType === '1') || (examineId && detailInfo.approvalStatus === 2 && isCurrentAudit)}}" style="position:fixed;bottom:0rpx;width:100%;background:#fff;padding-bottom:20rpx">
    <submit-opinion-popup keyId="" examineId="{{examineId}}" specialUserIds="{{detailInfo.countersignLeader}}" dingTalkFormList="{{dingTalkFormList}}" onApprovalOperate="bindApprovalOperateTap"></submit-opinion-popup>
  </view>
</view>
<block a:if="{{ current === 1 }}">
  <approval-item projectId={{detailInfo.projectId}} keyId={{detailInfo.id}}></approval-item>
</block>

<block a:if="{{ current === 2 }}">
  <view class="supplement-list flex f-between" a:for="{{ supplementList }}" a:key="index" data-item="{{item}}"  catchTap="toDetail">
    <view>
      <view class="title">{{item.contractName}}</view>
      <view class="info">合同号：{{item.contractNumber || '-'}}</view>
      <view class="info">乙方单位：{{item.unitPartyName || '-'}}</view>
      <view class="info">合同金额：{{item.contractAmount || '-'}}万元</view>
    </view>
    <image mode="scaleToFill" src="/assets/images/common/arrow-right.png" />
  </view>
</block>