<nav-bar navbarData="{{navbarData}}"></nav-bar>
<view class="container">
  <form onSubmit="bindFormSubmit">
    <view class="box-shadow" >
       <view a:if="{{disabled  ===false}}" catchTap="bindChooseProjectTap">
        <form-input
        label="项目名称"
        name="projectName"
        placeholder="请选择"
        disabled
        ref="handleRef"><icon slot="suffix" type="RightOutline" /></form-input>  
       </view>
       <view a:else >
        <form-input
        label="项目名称"
        name="projectName"
        placeholder="请选择"
        disabled
        ref="handleRef"><icon slot="suffix" type="RightOutline" /></form-input>  
       </view>
       <view a:if="{{disabled  ===false}}" catchTap="bindChooseContractNameTap">
        <form-input
        label="合同名称"
        name="contractName"
        placeholder="请选择"
        disabled
        ref="handleRef" ><icon slot="suffix" type="RightOutline" /></form-input>  
       </view>
       <view a:else>
        <form-input
        label="合同名称"
        name="contractName"
        placeholder="请选择"
        disabled
        ref="handleRef">  <icon slot="suffix" type="RightOutline" /></form-input>
       </view>
       <form-input
       label="合同金额(万元)"
       name="contractAmount"
       placeholder="选择合同后自动带入"
       type="number"
       disabled
       ref="handleRef" />
       <form-input
       label="承包商名称"
       name="contractorName"
       placeholder="选择合同后自动带入"
       disabled
       ref="handleRef" />
       <view catchTap="bindChooseApplyDateTap">
        <form-input
        label="申请日期"
        name="applicationTime"
        placeholder="请选择"
        allowClear
        disabled
        ref="handleRef"><icon slot="suffix" type="RightOutline" /></form-input>
      </view>
      <form-input
      label="送审定价(万元)"
      name="pricingTrial"
      placeholder="请输入"
      type="number"
        allowClear
      style="text-align:left"
      ref="handleRef" />
      <!-- <layout-field-cell disabled="{{disabled}}"  name="项目名称" mustFill placeholder="请选择" value="{{projectData.name}}" 
      onArrowTap="bindChooseProjectTap"></layout-field-cell>
      <layout-field-cell disabled="{{disabled}}" borderTop name="合同名称" mustFill placeholder="请选择"  value="{{contractData.contractName}}"  onArrowTap="bindChooseContractNameTap"></layout-field-cell>
      <layout-field-cell hidden={{false}} borderTop name="合同金额(万元)" mustFill placeholder="选择合同后自动带入"  value="{{contractAmount}}"></layout-field-cell>
      <layout-field-cell hidden={{false}} borderTop name="承包商名称" mustFill placeholder="选择合同后自动带入"  value="{{contractorName}}"></layout-field-cell>
      <layout-field-cell borderTop name="申请日期" mustFill placeholder="请选择" value="{{applicationTime}}" onArrowTap="bindChooseApplyDateTap"></layout-field-cell>
      <layout-field-input borderTop borderBottom name="送审定价(万元)" inputType="number" inputName="pricingTrial" mustFill disabled="{{isEdit}}" value="{{pricingTrial}}" placeholder="请输入"></layout-field-input> -->
      <form-radio-group
      onChange="onChange"
      required
      label="净核算金额(万元)"
      name="adjust"
      value="{{adjust}}"
      options="{{radioGroupOptions}}"
      ref="handleRef" />
      <form-input
      name="netAccountAmount"
      placeholder="请输入"
      type="number"
        allowClear
      style="text-align:left"
      ref="handleRef" />
      <form-input
      label="审定总价(万元)"
      name="approveTotalPrice"
      placeholder="请输入"
      type="number"
        allowClear
      style="text-align:left"
      ref="handleRef" />
      <!-- <layout-field-input inputType="number"  inputName="netAccountAmount"  disabled="{{isEdit}}" value="{{netAccountAmount}}" placeholder="请输入"></layout-field-input>
      <layout-field-input  name="审定总价(万元)" inputType="number" borderTop mustFill inputName="approveTotalPrice"  disabled="{{isEdit}}" value="{{approveTotalPrice}}" placeholder="请输入"></layout-field-input> -->
    </view>
    <view class="bottom-shadow" >
      <layout-field-cell hidden={{false}}  mustFill name="相关附件"></layout-field-cell>
       <layout-upload-img ref="onSaveUploadImgRef" cssStyle="margin: 30rpx 30rpx 0;"></layout-upload-img>
    </view>
    <view class="buttons flex f-between">
      <button class="btn" catchTap="bindCancelTap">取  消</button>
      <button class="btn active" form-type="submit" onTap="submit">保  存</button>
  </view>
  </form>
</view>
<dialog-select-project ref="onSaveDialogScreenprojecteRef"    onScreenCallBack="bindChooseProjectCallBack"></dialog-select-project>
<dialog-screen-hetong-mingcheng ref="onSaveDialogScreencontractRef" projectId="{{projectId}}"  positionBottom="{{true}}"   onScreenCallBack="bindChooseContractCallBack"></dialog-screen-hetong-mingcheng>
<dialog-picker-date ref="onSaveDialogScreenApplyDateRef" formatDate='YYYY-MM-DD'selectionMode="single"  onPickerCallBack="bindChooseApplyDateCallBack"></dialog-picker-date>