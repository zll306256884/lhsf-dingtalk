.container{
  position: relative;
}
.container .box-shadow {
  padding: 0 0;
  width: 100%;
}
.ant-input-placeholder{
  font-size: 30rpx;
}
.ant-input-content{
  text-align: right;
  font-size: 28rpx;
  color:#999
}
.ant-radio-group-horizontal .ant-radio-group-body{
  justify-content: flex-end;
}
.field-cell {
  margin: 0;
  padding: 30rpx 30rpx;
}
.ant-input-disabled{
  opacity: 1.4!important;
}
.box-shadow.field-cell {
  margin: 30rpx auto 0;
  padding: 30rpx 30rpx;
}

.field-cell .value,
.field-cell .input {
  font-size: 24rpx;
  text-align: right;
  color: #B8BFCC;
}

.field-cell .value.active,
.field-cell .placeholder-class.active {
  color: #525966;
}

/* 任务描述 */
.box-shadow .desc {
  margin: 10rpx 30rpx 0;
  height: 100rpx;
  font-size: 28rpx;
  color: #525966;
}
.buttons{
  border-top: 1px solid #DBDADF;
  padding: 16rpx 18rpx;
  margin-top: 16rpx;
  width: 718rpx;
  position: fixed;
  bottom: 0;
  background: #fff;
  padding-bottom: 42rpx!important;
}
/* btn */
.buttons .btn {
  width: 100%;
 height: 80rpx;
 background: #FFFFFF;
 border-radius: 8rpx 8rpx 8rpx 8rpx;
 opacity: 1;
 border: 2rpx solid #EBEDF0;
 font-size: 28rpx;
 font-family: PingFang SC-Regular, PingFang SC;
 font-weight: 400;
 color: #323233;
 line-height: 80rpx;
}
.ant-textarea-content{
  color:#999
}
.buttons .active {
  margin-left: 20rpx;
  color: white;
  background-color: #377DFF;
}
.bottom-shadow{
  padding-bottom: 20rpx;
  margin-top: 20rpx;
  margin-bottom: 140rpx;
background: #FFFFFF;
}
/* 任务描述 */
.box-shadow .desc {
  margin: 10rpx 30rpx 0;
  height: 100rpx;
  font-size: 28rpx;
  color: #525966;
}
.buttons {
  background: #ffffff;
  padding: 12px;
}
.button {
  margin-bottom: 12px;
}
.ant-form-item-content-horizontal{
  justify-content: space-between;
}
.ant-radio-group-body{
  float: right;
}
/* border-top: 1px solid #E7EAF3; */
.ant-form-item-asterisk{
  padding: 12px 18px 12px 20px;
}
.ant-form-item-label-horizontal{
  width: 144px;
  font-size: 32rpx;
}