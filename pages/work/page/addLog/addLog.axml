<nav-bar navbarData="{{navbarData}}"></nav-bar>
<view class="container">
  <form onSubmit="bindFormSubmit">
    <view class="containerinner">
      <!--<view class="title">
        项目信息</view> -->
      <layout-field-cell
        borderBottom
        name="项目名称"
        placeholder="请选择"
        value="{{formData.name}}"
        onArrowTap="bindChooseProjectTap"
      >
      </layout-field-cell>
      <layout-field-cell
        borderBottom
        name="日志日期"
        mustFill
        value="{{outPutTime.shortDate}}"
        onArrowTap="_bindChooseOutPutTime"
      >
      </layout-field-cell>
      <layout-field-cell
        borderBottom
        name="日志类型"
        mustFill
        value="{{isOutPut.name}}"
        onArrowTap="_bindChooseIsOutPut"
      >
      </layout-field-cell>
      <!-- 备注 -->
      <!-- <view class="" style="padding:0 32rpx;">
        <view class="">
          日志内容
        </view>
        <textarea
          class="remark"
          name="remark"
          maxlength="300"
          placeholder="请输入日志内容"
          placeholder-class="placeholder-class"
        >
        </textarea>
      </view> -->
      <layout-field-input
        mustFill
        name="日志内容"
        mustFillTransparent
        itemIndex="1"
        inputName="projectProgram"
        disabled="{{true}}"
        value="{{formData.projectProgram}}"
        placeholder=""
      >
      </layout-field-input>
      <textarea
        class="reason"
        name="constructionContent"
        maxlength="300"
        value="{{formData.constructionContent}}"
        placeholder="请输入内容"
        placeholder-class="placeholder-class"
        style="padding-left:30rpx;"
      >
      </textarea>
    </view>
   <!--  -->
    <view class="containerinner" style="margin-top:16rpx">
      <view class="redline-title">
        照片
      </view>
      <layout-upload-img
        cssStyle="margin: 0rpx 0 0;padding: 10rpx 30rpx 30rpx;"
        ref="onSaveUploadImgRef"
      >
      </layout-upload-img>
    </view>
    <!--  -->
    <view class="containerinner" style="margin-top:16rpx">
      <view class="redline-title">
        附件
      </view>
      <layout-upload-img
        cssStyle="margin: 0rpx 0 0;padding: 10rpx 30rpx 30rpx;"
        ref="onSaveUploadImgRef"
      >
      </layout-upload-img>
    </view>

    <view class="flex f-between btn-wrap">
      <button class="btn" catchTap="bindCancelTap">取消</button>
      <button class="btn active" form-type="submit">保存</button>
    </view>

    <view class="bottom-space"></view>
  </form>
</view>

<dialog-picker
  ref="onSaveDialogScreenQuesFromRef"
  dataList="{{screenFromList}}"
  onPickerChange="bindScreenFromCallBack"
>
</dialog-picker>

<dialog-picker
  ref="onSaveDialogScreenIsOutPutRef"
  dataList="{{isOutPutOption}}"
  onPickerChange="bindIsOutPutRef"
>
</dialog-picker>

<dialog-picker
  ref="onSaveDialogProjectClassificationFromRef"
  dataList="{{projectClassificationOptions}}"
  onPickerChange="bindProjectClassificationCallBack"
>
</dialog-picker>
<dialog-picker
  ref="onSaveDialogScreenConstructionPhase"
  dataList="{{constructionPhaseOptions}}"
  onPickerChange="bindScreenConstructionPhase"
>
</dialog-picker>

<dialog-picker
  ref="onSaveDialogEngineeringProperties"
  dataList="{{engineeringPropertiesOptions}}"
  onPickerChange="bindScreenEngineeringPropertiesFromCallBack"
>
</dialog-picker>
<dialog-picker
  ref="onSaveDialogConstructionNature"
  dataList="{{constructionNatureOptions}}"
  onPickerChange="bindScreenConstructionNatureFromCallBack"
>
</dialog-picker>

<dialog-picker-date ref="onSavePickerDateRef" onPickerCallBack="bindPickerDateCannBack">
</dialog-picker-date>



<dialog-screen-project-name
  ref="onSaveDialogScreenprojecteRef"
  positionBottom="{{true}}"
  onScreenCallBack="bindChooseProjectCallBack"
>
</dialog-screen-project-name>
<!--<dialog-picker-date-range ref="onSavePickerDatRangeRef" onPickerCallBack="bindPickerDateRangeCallBack"></dialog-picker-date-range><dialog-picker-date-range ref="onSavePickerActualDatRangeRef" onPickerCallBack="bindPickerActualDateRangeCallBack"></dialog-picker-date-range> -->