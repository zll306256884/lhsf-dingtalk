<nav-bar navbarData="{{navbarData}}"></nav-bar>

<view class="container" id="addLog">
  <view class="containerinner">
    <!-- <form-picker label="日志范畴" arrow name="logCategory" placeholder="请选择" options="{{logCategoryOption}}" ref="handleRef" onOk="chooseLogCategory" /> -->
    <form-radio-group
      label="日志范畴"
      name="logCategory"
      options="{{logCategoryOption}}"
      onChange="chooseLogCategory"
      ref="handleRef" />

    <form-radio-group
      label="日志类型"
      name="logType"
      options="{{logTypeOption}}"
      onChange="chooseLogType"
      ref="handleRef" />

    <!-- <view catchTap="_bindLogType">
      <form-picker label="日志类型" arrow disabled name="logTypeName" placeholder="请选择" options="{{logTypeOptionShow}}" ref="handleRef" />
    </view> -->
    <view a:if="{{logType=='1'}}" icon="ExclamationCircleOutline" class="tips"> * 记录具有重大影响的事件或决策，项目的关键节点等</view>
    <view a:if="{{logType=='0'}}" class="tips"> * 项目的日常进展、任务完成情况、团队成员的工作情况等内容</view>

    <!-- 项目名称 -->
    <view catchTap="_bindChooseLogProject" class="flex f-start  f-align-center">
      <view a:if="{{ logCategory == 2 }}" class='redStart'>*</view>
      <view style="width:99%">
        <form-picker label="项目名称" arrow disabled options="{{projectListOptions}}" name="projectId" ref="handleRef" />
      </view>
    </view>
    
    <!-- 日志日期 -->
    <view catchTap="_bindLogTime">
      <!--<form-picker label="日志日期" arrow disabled name="logDate" placeholder="请选择" ref="handleRef"></form-picker> -->
      <form-input label="日志日期" name="logDate" placeholder="请选择" placeholder-class="placeholderClassName" placeholder-style="color:#ccc;opacity:1;font-size:16px" 
        disabled ref="handleRef">
        <icon slot="suffix" type="RightOutline" /></form-input>
    </view>
    
    <!--日志内容  -->
    <view>
      <form-textarea label="日志内容" position='vertical' name="logContent" placeholder="请输入" allowClear maxLength="300" autoHeight 
        ref="handleRef" />
      <!--<layout-field-cell name="日志内容" mustFill value=" " hidden="{{false}}"></layout-field-cell><textarea class="reason" name="logContent" maxlength="300" value="{{logContent}}" placeholder="请输入内容" placeholder-class="placeholder-class"></textarea> -->
    </view>
  </view>

  <view class="containerinner" style="margin-top:16rpx">
    <view class="redline-title">
      <view class='redStart'>*</view>
      证明材料
    </view>
    <view class="tips"> * 上传现场照片、决策文档、会议照片、会议纪要等证明材料</view>
    <layout-upload-img cssStyle="margin: 0rpx 0 0;padding: 10rpx 30rpx 30rpx;" ref="onSaveUploadFileRef">
    </layout-upload-img>
  </view>

  <!-- <view class="containerinner" style="margin-top:16rpx">
    <view class="redline-title">
      <view class='redStart' a:if="{{logTypeName=='重大事件'}}">*</view>
      照片
    </view>
    <layout-upload-img cssStyle="margin: 0rpx 0 0;padding: 10rpx 30rpx 30rpx;" ref="onSaveUploadImgRef" onlyUploadImage="{{true}}">
    </layout-upload-img>
  </view>
  <view class="containerinner" style="margin-top:16rpx">
    <view class="redline-title">
        附件
    </view>
    <layout-upload-img cssStyle="margin: 0rpx 0 0;padding: 10rpx 30rpx 30rpx;" ref="onSaveUploadFileRef">
    </layout-upload-img>
  </view> -->
  
  <view class="bottom-space" style="height:150rpx"></view>
  <view class="flex f-between btn-wrap">
    <button class="btn" catchTap="bindCancelTap">取消</button>
    <button class="btn active" onTap="logAddSubmit">保存</button>
  </view>
  
</view>

<!-- 项目名称选择 -->
<dialog-select-project ref="onSaveDialogLogProjectNameRef" onScreenCallBack="bindChooseLogProjectCallBack">
</dialog-select-project>

<!-- 日志日期 -->
<dialog-picker-date ref="onSavePickerDateRef" formatDate="YYYY-MM-DD" onPickerCallBack="bindPickerDateCannBack">
</dialog-picker-date>

<!-- 日志类型 -->
<dialog-picker ref="onSaveDialogLogTypetRef" dataList="{{logTypeOption}}" onPickerChange="bindLogTypeRef">
</dialog-picker>

