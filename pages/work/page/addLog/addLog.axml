  ref="onSaveDialogScreenQuesFromRef"
  dataList="{{screenFromList}}"
  onPickerChange="bindScreenFromCallBack"
></dialog-picker><dialog-picker
  ref="onSaveDialogProjectClassificationFromRef"
  dataList="{{projectClassificationOptions}}"
  onPickerChange="bindProjectClassificationCallBack"
