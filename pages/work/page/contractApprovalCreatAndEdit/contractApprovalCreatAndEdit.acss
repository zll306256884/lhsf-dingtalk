.ant-input-content{
  text-align: right;
  font-size: 28rpx;
}
.ant-radio-group-horizontal .ant-radio-group-body{
  justify-content: flex-end;
}
.addunit{
  width: 100%;
  height: 96rpx;
  background: #FFFFFF;
  border-radius: 0rpx 0rpx 0rpx 0rpx;
  opacity: 1;
  font-size: 28rpx;
  font-family: PingFang SC-Medium, PingFang SC;
  font-weight: 500;
  color: #1A6AFF;
  line-height: 96rpx;
  margin: 16rpx 0;
  text-align: center;
}
.buttons{
  border-top: 1px solid #EBEDF0;
  padding: 16rpx 18rpx;
  margin-top: 16rpx;
  background: #fff;
  position: fixed;
  bottom: 0;
  width: 718rpx;
  z-index: 8;
}
.buttons .btn{
  width: 227rpx;
  height: 80rpx;
  background: #FFFFFF;
  border-radius: 8rpx 8rpx 8rpx 8rpx;
  opacity: 1;
  border: 2rpx solid #EBEDF0;
  font-size: 28rpx;
  font-family: PingFang SC-Regular, PingFang SC;
  font-weight: 400;
  color: #323233;
  line-height: 80rpx;
}
.buttons .active{
  color: #fff;
  background: #1A6AFF;
}
.ant-button{
  padding: 0;
}
.ant-button-default{
  box-shadow:none
}
.ant-picker-value-text{
  color:#000
}
.ant-input-placeholder{
  font-size: 30rpx;
}
.f-item{
  font-size: 28rpx;
  font-family: PingFang SC, PingFang SC;
  font-weight: 400;
  color: #323233;
}
.ant-input-disabled .ant-input-content{
  color:black;
  opacity: 1;
}
.ant-input-content{
  opacity: 1 !important;
}
.ant-picker-value-text{
  font-size: 28rpx;
  color: #323233;
}
.ant-picker-value-placeholder{
  font-size: 28rpx;
}
.f-item{
  font-size: 28rpx;
  color: #323233;
}