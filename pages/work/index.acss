.image{
  width: 100%;
  height: 660rpx;
}
.grid{
width: 702rpx;
height: 408rpx;
background: #FFFFFF;
border-radius: 16rpx;
opacity: 1;
margin:-70rpx auto 0;
}
.grid-icon{
width: 100rpx;
height: 100rpx;
background: linear-gradient(180deg, #5E8FFF 0%, #3271FF 100%);
opacity: 1;
margin:24rpx 34rpx
}
.grid-text {
  width: 100%;
  display: block;
  font-size: 26rpx;
  font-family: PingFang SC-Regular, PingFang SC;
  font-weight: 400;
  color: #1D1D1F;
  line-height: 44rpx;
  text-align: center;
}