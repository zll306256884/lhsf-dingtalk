.image {
  width: 100%;
  height: 660rpx;
}
.ant-tabs-bar-basic {
  padding: 8px 0px;
}
.grid {
  width: 100%;
  height: 408rpx;
  background: #ffffff;
  border-radius: 16rpx;
  opacity: 1;
  margin: -70rpx auto 0;
}
.grid-icon {
  width: 100rpx;
  height: 100rpx;
  background-size: 100% 100%;
  background: linear-gradient(180deg, #5e8fff 0%, #3271ff 100%);
  opacity: 1;
  margin: 24rpx 34rpx;
}
.grid-text {
  width: 100%;
  display: block;
  font-size: 26rpx;
  font-weight: 400;
  color: #1d1d1f;
  line-height: 44rpx;
  text-align: center;
}
.list-item {
  padding: 24rpx 0;
  border-bottom: 2rpx solid #ebeef5;
}
.item-status-error {
  display: inline-block;
  background: #feecec;
  border-radius: 4rpx 4rpx 4rpx 4rpx;
  opacity: 1;
  border: 2rpx solid #fdd9d9;
  padding: 0rpx 16rpx;
  margin-right: 16rpx;
  color: #f53f3f;
}
.item-status-sucess {
  display: inline-block;
  border-radius: 4rpx 4rpx 4rpx 4rpx;
  opacity: 1;
  border: 2rpx solid #ccf0d4;
  padding: 0rpx 16rpx;
  margin-right: 16rpx;
  color: #00b42a;
  background: #e6f8ea;
}
.item-status-warning {
  display: inline-block;
  border-radius: 4rpx 4rpx 4rpx 4rpx;
  opacity: 1;
  border: 2rpx solid #ffe5cc;
  padding: 0rpx 16rpx;
  margin-right: 16rpx;
  color: #ff7d00;
  background: #fff2e6;
}
.item-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1d1d1f;
  line-height: 44rpx;
  margin-bottom: 16rpx;
}

.avatar-name {
  width: 140rpx;
  height: 48rpx;
  background: #f3f4f5;
  border-radius: 38rpx;
  opacity: 1;
  margin-left: 16rpx;
}
.item-name {
  font-size: 24rpx;
  font-family: PingFang SC-Regular, PingFang SC;
  font-weight: 400;
  color: #606266;
  line-height: 48rpx;
  margin: 0 8rpx;
}
.item-avatar {
  max-width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  object-fit: contain;
}
.item-label {
  font-size: 24rpx;
  font-weight: 400;
  color: #909399;
  line-height: 40rpx;
}
.list-more {
  text-align: center;
  font-size: 28rpx;
  font-weight: 400;
  color: #606266;
  line-height: 44rpx;
  margin: 0 auto;
  padding: 24rpx 0;
}
.task {
  margin: 32rpx 0;
}
.task-title {
  font-weight: 500;
  color: #1d1d1f;
  font-size: 32rpx;
}
.ant-tabs-bar-scroll-view {
  justify-content: flex-start;
  height: 96rpx;
}
.ant-tabs-bar-item {
  margin-right: 40rpx;
  font-weight: 400;
  color: #606266;
  font-size: 28rpx;
}
