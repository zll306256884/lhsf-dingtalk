
<import-sjs from="../../utils/utils.sjs" name="utils" />
<view class="container">
  <image class="image"  src="../../../../assets/images/work/Group-top.png" />
  <view class="card-wrap">
    <view class="grid">
      <view a:if="{{ iconList && iconList.length }}" class="flex f-start f-row f-around f-wrap">
        <view a:for="{{iconList}}" key="{{item.name}}" class="grid-item" onTap="onItemTap" data-index="{{index}}" data-path="{{item.path}}">
          <image class="grid-icon"  src="{{item.url}}" /> 
          <text class="grid-text">{{item.name}}</text>
        </view>
      </view>
      <view a:else class="flex f-center" style="align-items:center;height:100%">
        <view style="margin-bottom:32rpx">
          <image mode="scaleToFill" src="/assets/images/common/empty.png" style="width:69px;height:104px;" />
          <!-- <span style="font-size: 12px;color: #909399;margin-top:4px">暂无权限</span> -->
        </view>
      </view>
    </view>
<!-- 待办列表 -->
    <view class="card approval" style="margin-top:32rpx">
      <tabs items="{{tabs1}}" current="{{currentAwait}}" onChange="onAwaitChange">
        <view slot="title" slot-scope="item">
          <view>{{item.value.title}}{{'(' + item.value.count +')'}}</view>
        </view>
      </tabs>
        <list a:if="{{listData.length}}">
        <list-item> 
          <view class="list-item" a:for="{{listData}}" data-item={{item}} data-index={{index}} onTap="selectAwaitInfo">
            <view class="item-title two-lines" style="{{item.isRead && item.isRead===1?'color:#606266':''}}">
            <view a:if="{{currentAwait!==0 && (item.taskStatus===5 || item.tagType===2)}}" class="item-status-error">
              {{item.taskStatus && '逾期' || (item.tagType  && '驳回')}}
            </view>
            {{item.taskName || item.title || '-'}}
          </view>
            <view class="flex f-row f-between">
              <view class="flex f-row f-between">
              <text class="item-label">{{['申请人','创建人','创建人'][currentAwait]}}</text>
              <view class="avatar-name flex f-row f-start">
              <image a:if="{{item.avatar}}" class="item-avatar"  src="{{item.avatar}}" />
              <view a:else class="item-avatar-default" >{{(item.userName || item.createUserName).split('')[0]}}</view>
              <text class="item-name single-line"> {{item.userName || item.createUserName}}</text>
              </view>
            </view>
              <text class="item-label">{{['提交时间','截止时间','创建时间'][currentAwait]}}：{{utils.parseTime(item.createTime || item.endTime,'{y}-{m}-{d} {h}:{i}')}}</text>
          </view>
          </view>
          <view class="list-more" onTap="handleTap">
          <text onTap="selectMoreAwait">查看更多</text>
          <icon type="RightOutline" />
          </view>
        </list-item>
        </list>
        <empty a:else image="/assets/images/common/empty.png" />
    </view>
<!-- 我的审批 -->
    <view class="task flex f-row f-between">
      <text class="task-title">我的审批</text>
      <view style="color:#606266;font-size:28rpx;" onTap="selectMoreApproval">
        <text>查看更多</text>
        <icon type="RightOutline" />
      </view>
    </view>
    <view class="card">
      <tabs items="{{tabs2}}" onChange="onApprovalChange" />
      <list a:if="{{listApproval.length}}">
        <list-item> 
          <view class="list-item" a:for="{{listApproval}}" data-item={{item}} data-index={{index}} onTap="selectApprovalInfo">
            <view class="item-title two-lines">{{item.taskName}} </view>
            <view class="flex f-row f-between">
              <view class="flex f-row f-between">
              <text class="item-label">申请人</text>
              <view class="avatar-name flex f-row f-start">
              <image a:if="{{item.avatar}}" class="item-avatar"  src="{{item.avatar}}" />
              <view a:else class="item-avatar-default" >{{item.userName.split('')[0]}}</view>
              <text class="item-name single-line"> {{item.userName}}</text>
              </view>
            </view>
              <text class="item-label">提交时间：{{utils.parseTime(item.createTime,'{y}-{m}-{d} {h}:{i}')}}</text>
          </view>
          </view>
        </list-item>
        </list>
        <empty a:else image="/assets/images/common/empty.png" />
      </view>
<!-- 我的任务 -->
      <view class="task flex f-row f-between">
        <text class="task-title">我的任务</text>
        <view style="color:#606266;font-size:28rpx;" onTap="selectMoreTask">
          <text>查看更多</text>
          <icon type="RightOutline" />
        </view>
      </view>
      <view class="card">
        <tabs items="{{tabs3}}" current="{{currentTask}}" onChange="onTaskChange" >
          <view slot="title" slot-scope="item">
            <view a:if="{{item.index===0}}">{{item.value.title}}{{'(' + item.value.count +')'}}</view>
            <view a:else>{{item.value.title}}</view>
          </view>
        </tabs>
        <list a:if="{{listTask.length}}">
          <list-item> 
            <view class="list-item" a:for="{{listTask}}" data-index={{index}} data-item={{item}} onTap="selectTaskInfo">
              <view class="item-title two-lines">
                <view class="{{item.taskStatus===5?'item-status-error':''}}" a:if="{{currentTask===0}}"> {{ item.taskStatus===5? '逾期':""}} </view>
                <view a:else class="{{item.missionId==='0' && 'item-status-sucess' || (item.missionId!=='0' && 'item-status-warning')}}">
                  {{ item.missionId==='0' && '发起' || (item.missionId!=='0' && '协作')}}
                </view>
                {{item.title}} 
                </view>
              <view class="flex f-row f-between">
                <text class="item-label">{{['截止日期','完成日期','取消日期'][currentTask]}}：{{utils.parseTime([item.endTime,item.finishTime,item.updateTime][currentTask],'{y}-{m}-{d} {h}:{i}')}}</text>
            </view>
            </view>
          </list-item>
          </list>
        <empty a:else image="/assets/images/common/empty.png" />
        </view>
<!-- 我的请求 -->
        <view class="task flex f-row f-between">
          <text class="task-title">我的请求</text>
          <view style="color:#606266;font-size:28rpx;" onTap="selectMoreQuery">
            <text>查看更多</text>
            <icon type="RightOutline" />
          </view>
        </view>
        <view class="card">
          <tabs items="{{tabs4}}" onChange="onQueryChange" >
            <view slot="title" slot-scope="item">
              <view a:if="{{item.index===0}}">{{item.value.title}}{{'(' + item.value.count +')'}}</view>
              <view a:else>{{item.value.title}}</view>
            </view>
          </tabs>
          <list a:if="{{listQuery.length}}">
            <list-item> 
              <view class="list-item" a:for="{{listQuery}}" data-item={{item}} data-index={{index}} onTap="selectQueryInfo">
                <view class="item-title two-lines">{{item.title}} </view>
                <view class="flex f-row f-between">
                  <text class="item-label">创建时间：{{utils.parseTime(item.createTime,'{y}-{m}-{d} {h}:{i}')}}</text>
              </view>
              </view>
            </list-item>
            </list>
        <empty a:else image="/assets/images/common/empty.png" />
    </view>
  </view>
</view>

<ant-modal
  title="合同审批流程"
  visible="{{ basicTwoVisible }}"
  onClose="handleClose"
  primaryButtonText="确认"
  secondaryButtonText="取消"
  onPrimaryButtonTap="handlePrimaryButtonTap"
  onSecondaryButtonTap="handleSecondaryButtonTap">

  <ant-container title="合同审批流程" class="modalbody">
    <form-radio-group
      label="选择类型:"
      name="contractType"
      labelWidth="124rpx"
      options="{{ radioGroupOptions }}"
      ref="handleRef" />
    <view class="buttons flex f-between">
      <button class="btn" onTap="reset">取消</button>
      <button class="btn active" type="primary" onTap="submit" style="margin-bottom: 12px">确认</button>
    </view>
  </ant-container>
</ant-modal>