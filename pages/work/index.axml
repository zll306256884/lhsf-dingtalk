<view class="container">
  <image class="image"  src="../../../../assets/images/work/Group-top.png" />
  <view class="grid">
    <view class="flex f-row f-around f-wrap">
      <view a:for="{{iconList}}" key="{{item.name}}" class="grid-item" onTap="{{onItemTap}}" data-index="{{index}}">
      <image class="grid-icon"  src="{{item.url}}" /> 
      <text class="grid-text">{{item.name}}</text>
      </view>
    </view>
  </view>
  <field-cell borderBottom name="进场检查时间"  placeholder="请选择日期" value="{{selectedDate}}" onArrowTap="handleDateChange" ></field-cell>

</view>
<dialog-picker-date ref="onSaveDialogPickerDateRef" showHourMinuteSecond onPickerCallBack="bindPickerDateCallBack"></dialog-picker-date>