.greenTypeBtn {
  width: 76rpx;
  height: 36rpx;
  background: #E6F8EA;
  border-radius: 8rpx 8rpx 8rpx 8rpx;
  opacity: 1;
  font-size: 20rpx;
  color: #00B42A;
  text-align: center;
  display: inline-block;
  line-height: 40rpx;
}

.greenTypeSpot {
  width: 32rpx;
  height: 32rpx;
  opacity: 1;
  display: inline-block;
  line-height: 40rpx;
  /* margin: 8rpx;
  background: #00B42A; */
}


